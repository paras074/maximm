                                          </a>
                                        </div>
                                        <h6 class="title">
                                          <a href="{{ block.settings.list_url_one }}">
                                            <span class="ico">
                                              <img src="{{ 'maximm-logo-single-element-blue-2.svg' | asset_url }}">
                                            </span>
                                            {{ block.settings.list_title_one }}
                                          </a>
                                        </h6>
                                      </div>
                                      <div class="{% if block.settings.list_image_four != blank %}st-col-md-3{% else %}st-col-md-4{% endif %} card-item">
                                        <div class="image-holder">
                                          <a class="d-block" href="{{ block.settings.list_url_two }}">
                                            {{ block.settings.list_image_two | image_url: width: 400 | image_tag: class: 'w-100' }}
                                          </a>
                                        </div>
                                        <h6 class="title">
                                          <a href="{{ block.settings.list_url_two }}">
                                            <span class="ico">
                                              <img src="{{ 'maximm-logo-single-element-blue-2.svg' | asset_url }}">
                                            </span>
                                            {{ block.settings.list_title_two }}
                                          </a>
                                        </h6>
                                      </div>
                                      <div class="{% if block.settings.list_image_four != blank %}st-col-md-3{% else %}st-col-md-4{% endif %} card-item">
                                        <div class="image-holder">
                                          <a class="d-block" href="{{ block.settings.list_url_three }}">
                                            {{ block.settings.list_image_three | image_url: width: 400  | image_tag: class: 'w-100' }}
                                          </a>
                                        </div>
                                        <h6 class="title">
                                          <a href="{{ block.settings.list_url_three }}">
                                            <span class="ico">
                                              <img src="{{ 'maximm-logo-single-element-blue-2.svg' | asset_url }}">
                                            </span>
                                            {{ block.settings.list_title_three }}
                                          </a>
                                        </h6>
                                      </div>
                                      {% if block.settings.list_image_four != blank %}
                                      <div class="st-col-md-3 card-item">
                                        <div class="image-holder">
                                          <a class="d-block" href="{{ block.settings.list_url_four }}">
                                            {{ block.settings.list_image_four | image_url: width: 400  | image_tag: class: 'w-100' }}
                                          </a>
                                        </div>
                                        <h6 class="title">
                                          <a href="{{ block.settings.list_url_four }}">
                                            <span class="ico">
                                              <img src="{{ 'maximm-logo-single-element-blue-2.svg' | asset_url }}">
                                            </span>
                                            {{ block.settings.list_title_four }}
                                          </a>
                                        </h6>
                                      </div>  
                                      {% endif %}                          
                                    </div>
                                  </div>
                                {% endif %}
                              {% endif %}
                            {%  endfor %}
                          </div>
                        </div>
                      </div>
                    </details>
                  {%- else -%}
                    <a
                      id="HeaderDrawer-{{ link.handle }}"
                      href="{{ link.url }}"
                      class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.current %} menu-drawer__menu-item--active{% endif %}"
                      {% if link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{ link.title | escape }}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>

