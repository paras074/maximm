{% comment %}
  Renders a header drawer menu for mobile and desktop.

  Usage:
  {% render 'header-drawer' %}
{% endcomment %}

<header-drawer class="header-drawer-mobile" data-breakpoint="{% if section.settings.menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary
      class="header__icon header__icon--menu header__icon--summary link focus-inset"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <span>
        {% render 'icon-hamburger' %}
        {% render 'icon-close' %}
      </span>
    </summary>
    <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-{{ section.settings.menu_color_scheme }}">
      <div class="menu-drawer__inner-container">
        <div class="wholesale-wrap">
          <div class="wholesale-wrap__inner">
            <div class="wholesale-login">
              {% if customer and customer.tags contains 'b2b' or customer.tags contains 'B2B' %}
                <span class="title">
                  My B2B Account
                </span>
                <a href="/account">{{ customer.first_name }}{{ customer.last_name | prepend: ' ' }}</a>
              {% else %}
                <span class="title">
                  Wholesale
                </span>
                <a href="/pages/trade-login">Login/Sign up</a>
              {% endif %}
            </div>
            <div class="header__icons">
              {% unless customer and customer.tags contains 'b2b' or customer.tags contains 'B2B' %}
                {%- if shop.customer_accounts_enabled -%}
                  <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="header__icon header__icon--account link focus-inset">
                    {% render 'icon-account' %}
                    <span class="visually-hidden">
                      {%- liquid
                        if customer
                          echo 'customer.account_fallback' | t
                        else
                          echo 'customer.log_in' | t
                        endif
                      -%}
                    </span>
                  </a>
                {%- endif -%}
              {% endunless %}
      
              {%- for block in section.blocks -%}
                {%- case block.type -%}
                  {%- when '@app' -%}
                    {% render block %}
                {%- endcase -%}
              {%- endfor -%}
      
              <button class="st-wishlist-details-button st-wishlist-details-button--header-icon" data-type="manually"></button>
      
              <a href="{{ routes.cart_url }}" class="header__icon header__icon--cart link focus-inset" id="cart-icon-bubble">
                {%- liquid
                  if cart == empty
                    render 'icon-cart-empty'
                  else
                    render 'icon-cart'
                  endif
                -%}
                <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
                {%- if cart != empty -%}
                  <div class="cart-count-bubble">
                    {%- if cart.item_count < 100 -%}
                      <span aria-hidden="true">{{ cart.item_count }}</span>
                    {%- endif -%}
                    <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
                  </div>
                {%- endif -%}
              </a>
            </div>
          </div>
          <a class="phone-wrapper" href="tel:845.219.1999" target="_blank">
            <span class="ico">{% render 'icon-phone-blue' %}</span>
            <span class="detail">Call us at</span>
            <span class="phone">845.219.1999</span>
          </a>
        </div>
        <div class="menu-drawer__navigation-container">
          <nav class="menu-drawer__navigation">
            <ul class="menu-drawer__menu has-submenu list-menu" role="list">
              {%- for link in section.settings.menu.links -%}
                <li>
                  {%- if link.links != blank -%}
                    <details id="Details-menu-drawer-menu-item-{{ forloop.index }}">
                      <summary
                        id="HeaderDrawer-{{ link.handle }}"
                        class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.child_active %} menu-drawer__menu-item--active{% endif %}"
                      >
                        {{ link.title | escape }}
                        {% render 'icon-caret' %}
                      </summary>
                      <div
                        id="link-{{ link.handle | escape }}"
                        class="menu-drawer__submenu has-submenu gradient motion-reduce"
                        tabindex="-1">
                        <div class="menu-drawer__inner-submenu">
                          <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                            {% render 'icon-caret' %}
                            Back
                          </button>

                         <ul class="menu-drawer__menu list-menu" role="list">
                            <div class="menu-item">
                              <span class="title">{{ link.title | escape }}</span>
                              {% render 'icon-caret' %}
                            </div>

                            {%- for childlink in link.links -%}
                              <li class="submenu-items">
                                <a class="header-link" href="{{ childlink.url }}">
                                  {{ childlink.title }}
                                </a>

                                {% if childlink.links != blank %}
                                  <ul class="inner-grandchild{% if childlink.title contains 'Bulk' %} mobile-menu-pack{% endif %}">
                                    {% for grandchild in childlink.links %}
                                      <li>
                                        <a href="{{ grandchild.url }}">{{ grandchild.title }}</a>
                                      </li>
                                    {% endfor %}
                                  </ul>
                                {% endif %}

                              </li>
                            {%- endfor -%}
                          </ul>
                          <div class="block-banner">
                            {% for block in section.blocks %}
                              {% assign link_handle = link.title | handleize %}
                              {% if link_handle == block.settings.title %}
                                {% if block.type == 'megamenu_large' %}
                                  <div class="mega-menu-right__box">
                                    <a href="{{ block.settings.large_banner_url }}">
                                      <div class="inner-container">
                                        <div class="image-holder">
                                          {{ block.settings.large_banner_image | image_url: width: 400 | image_tag: class: 'w-100' }}
                                        </div>
                                      </div>
                                    </a>
                                  </div>
                                {% elsif block.type == 'megamenu_list' %}
