                                    <div class="section-heading">
                                      <div class="title-wrapper">
                                        <div class="floating-logo-element">
                                          <svg width="40" height="36" viewBox="0 0 40 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M24.8848 6.90381C26.4632 3.51904 30.4866 2.05465 33.8713 3.63299C37.2561 5.21133 38.7205 9.23473 37.1422 12.6195L30.6397 26.564C29.0614 29.9488 25.038 31.4132 21.6532 29.8348C18.2685 28.2565 16.8041 24.2331 18.3824 20.8483L24.8848 6.90381Z" fill="url(#paint0_linear_320_21652)"/>
                                            <path d="M21.1781 15.3303C20.1555 17.4325 17.185 22.0795 14.4236 24.5571C11.8593 26.8578 10.6186 27.7027 10.3008 27.9388" stroke="#D3DDFF" stroke-width="0.170845"/>
                                            <path d="M5.87113 19.2045C6.81819 17.1735 9.23237 16.2948 11.2633 17.2419C13.2943 18.189 14.173 20.6031 13.226 22.6341L9.06955 31.5476C8.12249 33.5785 5.70831 34.4572 3.67733 33.5102C1.64635 32.5631 0.767666 30.1489 1.71473 28.1179L5.87113 19.2045Z" fill="url(#paint1_linear_320_21652)"/>
                                            <defs>
                                            <linearGradient id="paint0_linear_320_21652" x1="36.1366" y1="6.35438" x2="19.3317" y2="27.6584" gradientUnits="userSpaceOnUse">
