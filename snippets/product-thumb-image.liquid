{%  liquid
    assign show_all = show_all | default: false
    assign featured_media = product.selected_or_first_available_variant.featured_media
    
    assign color_names = 'Color, Colour, color, colour, Collor' | split: ', '

    # Determine color option
    assign color_option_position = nil
    for option in product.options_with_values
        for color_name in color_names
            if option.name == color_name
                assign color_option_position = option.position
                break
            endif
        endfor
        if color_option_position
            break
        endif
    endfor

    # Get selected variant's color
    assign selected_color = nil
    if color_option_position
        case color_option_position
            when 1
                assign selected_color = product.selected_or_first_available_variant.option1
            when 2
                assign selected_color = product.selected_or_first_available_variant.option2
            when 3
                assign selected_color = product.selected_or_first_available_variant.option3
        endcase
    endif

    # Find first variant with same color
    assign first_variant_with_color = nil
    if selected_color
        for variant in product.variants
            assign variant_color = nil
            case color_option_position
                when 1
                    assign variant_color = variant.option1
                when 2
                    assign variant_color = variant.option2
                when 3
                    assign variant_color = variant.option3
            endcase

            if variant_color == selected_color
                assign first_variant_with_color = variant
                break
            endif
        endfor
    endif

    # Count total variant images
    assign total_variant_images = 0
    if featured_media != nil
        assign total_variant_images = 1
    endif

    if first_variant_with_color and first_variant_with_color.metafields.custom.variant_images
        for variant_image in first_variant_with_color.metafields.custom.variant_images.value
            assign total_variant_images = total_variant_images | plus: 1
        endfor
    endif

    if product.selected_or_first_available_variant.metafields.custom.variant_images
        if first_variant_with_color.id != product.selected_or_first_available_variant.id
            for variant_image in product.selected_or_first_available_variant.metafields.custom.variant_images.value
                assign total_variant_images = total_variant_images | plus: 1
            endfor
        endif
    endif

    # Count all product videos
    assign total_variant_videos = 0
    for media in product.media
        if media.media_type contains 'video'
            assign total_variant_videos = total_variant_videos | plus: 1
        endif
    endfor

    if show_all
        assign max_thumbnails = 999
        assign show_count_overlay = false
        assign show_videos = false
    else
        assign max_thumbnails = 4
        assign show_count_overlay = true
        assign show_videos = true
    endif
    assign remaining_count = total_variant_images | minus: max_thumbnails
%}

<ul id="Slider-Thumbnails-{% if show_all %}Modal-{% endif %}{{ section.id }}"
    class="thumbnail-list{% if show_all %} thumbnail-list--modal{% endif %} list-unstyled slider slider--mobile{% if section.settings.gallery_layout == 'thumbnail_slider' %} slider--tablet-up{% endif %}"{% if show_all %} style="display: none;"{% endif %}>
    {%- capture sizes -%}
    (min-width: {{ settings.page_width }}px) calc(({{ settings.page_width | minus: 100 | times: media_width | round }} - 4rem) / 4),
    (min-width: 990px) calc(({{ media_width | times: 100 }}vw - 4rem) / 4),
    (min-width: 750px) calc((100vw - 15rem) / 8),
    calc((100vw - 8rem) / 3)
    {%- endcapture -%} 

    {%- assign thumbnail_counter = 0 -%}
    {%- assign image_index = 0 -%}

    {%- comment -%} 1. Featured image thumbnail {%- endcomment -%}
    {%- if featured_media != nil -%}
    {%- liquid
        assign image_index = image_index | plus: 1
        assign thumbnail_counter = thumbnail_counter | plus: 1
    -%}

        <li id="Slide-Thumbnails-{% if show_all %}Modal-{% endif %}{{ section.id }}-0"
            class="thumbnail-list__item slider__slide {%  if featured_media.media_type contains 'video' %}thumbnail-list__item-video{% else %}thumbnail-list__item-image{% endif%}"
            data-target="{{ section.id }}-{{ featured_media.id }}"
            data-media-position="{{ media_index }}">
            {%- capture thumbnail_id -%}
            Thumbnail-{% if show_all %}Modal-{% endif %}{{ section.id }}-0
            {%- endcapture -%}
            <button
            class="thumbnail global-media-settings global-media-settings--no-shadow"
            aria-label="{%- if featured_media.media_type == 'image' -%}{{ 'products.product.media.load_image' | t: index: media_index }}{%- elsif featured_media.media_type == 'model' -%}{{ 'products.product.media.load_model' | t: index: media_index }}{%- elsif featured_media.media_type == 'video' or featured_media.media_type == 'external_video' -%}{{ 'products.product.media.load_video' | t: index: media_index }}{%- endif -%}"
            aria-current="true"
            aria-controls="GalleryViewer-{{ section.id }}"
            aria-describedby="{{ thumbnail_id }}">
                {{
                    featured_media.preview_image
                    | image_url: width: 416
                    | image_tag:
                    loading: 'lazy',
                    sizes: sizes,
                    widths: '54, 74, 104, 162, 208, 324, 416',
                    id: thumbnail_id,
                    alt: featured_media.alt
                    | escape
                }}
            </button>
        </li>
    {%- endif -%}

    {%- comment -%} 2. First variant's metafield images {%- endcomment -%}
    {%- if first_variant_with_color and first_variant_with_color.metafields.custom.variant_images -%}
        {%- for variant_image in first_variant_with_color.metafields.custom.variant_images.value -%}
            {%- if thumbnail_counter < max_thumbnails -%}
                {%- assign image_index = image_index | plus: 1 -%}
                {%- assign thumbnail_counter = thumbnail_counter | plus: 1 -%}
                {%- assign is_fourth_thumbnail = false -%}
                {%- if show_count_overlay and thumbnail_counter == max_thumbnails and remaining_count > 0 -%}
                    {%- assign is_fourth_thumbnail = true -%}
                {%- endif -%}
                <li id="Slide-Thumbnails-{% if show_all %}Modal-{% endif %}{{ section.id }}-first-{{ forloop.index }}"
                    class="thumbnail-list__item slider__slide {% if is_fourth_thumbnail %}thumbnail-list__item--with-count{% endif %} thumbnail-list__item-image"
                    data-target="{{ section.id }}-first-{{ forloop.index }}"
                    data-media-position="{{ image_index }}"
                    {% if is_fourth_thumbnail %}data-lightbox-trigger="true" data-lightbox-tab="images" data-remaining-count="{{ remaining_count }}"{% endif %}>
                    {%- capture thumbnail_id -%}
                    Thumbnail-{% if show_all %}Modal-{% endif %}{{ section.id }}-first-{{ forloop.index }}
                    {%- endcapture -%}
                    <button
                    class="thumbnail global-media-settings global-media-settings--no-shadow"
                    aria-label="{{ 'products.product.media.load_image' | t: index: image_index }}"
                    aria-controls="GalleryViewer-{{ section.id }}"
                    aria-describedby="{{ thumbnail_id }}">
                        {{
                            variant_image
                            | image_url: width: 416
                            | image_tag:
                            loading: 'lazy',
                            sizes: sizes,
                            widths: '54, 74, 104, 162, 208, 324, 416',
                            id: thumbnail_id,
                            alt: product.title
                            | escape
                        }}
                        {%- if is_fourth_thumbnail -%}
                            <span class="thumbnail__count-overlay">+{{ remaining_count }}</span>
                        {%- endif -%}
                    </button>
                </li>
            {%- endif -%}
        {%- endfor -%}
    {%- endif -%}

    {%- comment -%} 3. Selected variant's metafield images (only if different) {%- endcomment -%}
    {%- if product.selected_or_first_available_variant.metafields.custom.variant_images -%}
        {%- if first_variant_with_color.id != product.selected_or_first_available_variant.id -%}
            {%- for variant_image in product.selected_or_first_available_variant.metafields.custom.variant_images.value -%}
                {%- if thumbnail_counter < max_thumbnails -%}
                    {%- assign image_index = image_index | plus: 1 -%}
                    {%- assign thumbnail_counter = thumbnail_counter | plus: 1 -%}
                    {%- assign is_fourth_thumbnail = false -%}
                    {%- if show_count_overlay and thumbnail_counter == max_thumbnails and remaining_count > 0 -%}
                        {%- assign is_fourth_thumbnail = true -%}
                    {%- endif -%}
                    <li id="Slide-Thumbnails-{% if show_all %}Modal-{% endif %}{{ section.id }}-selected-{{ forloop.index }}"
                        class="thumbnail-list__item slider__slide {% if is_fourth_thumbnail %}thumbnail-list__item--with-count{% endif %} thumbnail-list__item-image"
                        data-target="{{ section.id }}-selected-{{ forloop.index }}"
                        data-media-position="{{ image_index }}"
                        {% if is_fourth_thumbnail %}data-lightbox-trigger="true" data-lightbox-tab="images" data-remaining-count="{{ remaining_count }}"{% endif %}>
                        {%- capture thumbnail_id -%}
                        Thumbnail-{% if show_all %}Modal-{% endif %}{{ section.id }}-selected-{{ forloop.index }}
                        {%- endcapture -%}
                        <button
                        class="thumbnail global-media-settings global-media-settings--no-shadow"
                        aria-label="{{ 'products.product.media.load_image' | t: index: image_index }}"
                        aria-controls="GalleryViewer-{{ section.id }}"
                        aria-describedby="{{ thumbnail_id }}">
                            {{
                                variant_image
                                | image_url: width: 416
                                | image_tag:
                                loading: 'lazy',
                                sizes: sizes,
                                widths: '54, 74, 104, 162, 208, 324, 416',
                                id: thumbnail_id,
                                alt: product.title
                                | escape
                            }}
                            {%- if is_fourth_thumbnail -%}
                                <span class="thumbnail__count-overlay">+{{ remaining_count }}</span>
                            {%- endif -%}
                        </button>
                    </li>
                {%- endif -%}
            {%- endfor -%}
        {%- endif -%}
    {%- endif -%}


    {%- comment -%} 4. Video thumbnail (show only one with count) {%- endcomment -%}
    {%- if show_videos and total_variant_videos > 0 -%}
        {%- assign video_shown = false -%}
        {%- for media in product.media -%}
            {%- if media.media_type contains 'video' and video_shown == false -%}
                {%- comment -%} Always show video regardless of thumbnail count {%- endcomment -%}
                    {%- assign video_shown = true -%}
                    {%- assign thumbnail_counter = thumbnail_counter | plus: 1 -%}
                    {%- assign is_video_thumbnail = false -%}
                    {%- if total_variant_videos > 1 -%}
                        {%- assign is_video_thumbnail = true -%}
                    {%- endif -%}
                    <li id="Slide-Thumbnails-{% if show_all %}Modal-{% endif %}{{ section.id }}-video-1"
                        class="thumbnail-list__item slider__slide {% if is_video_thumbnail %}thumbnail-list__item--with-count{% endif %} thumbnail-list__item-video"
                        data-target="{{ section.id }}-video-1"
                        data-media-position="video-1"
                        data-lightbox-trigger="true" data-video-tab="true">
                        {%- capture thumbnail_id -%}
                        Thumbnail-{% if show_all %}Modal-{% endif %}{{ section.id }}-video-1
                        {%- endcapture -%}
                        <span class="thumbnail__badge" aria-hidden="true">
                            {%- render 'icon-play' -%}
                        </span>
                        <button
                        class="thumbnail global-media-settings global-media-settings--no-shadow"
                        aria-label="Play video"
                        aria-controls="GalleryViewer-{{ section.id }}"
                        aria-describedby="{{ thumbnail_id }}">
                            {{
                                media.preview_image
                                | image_url: width: 416
                                | image_tag:
                                loading: 'lazy',
                                sizes: sizes,
                                widths: '54, 74, 104, 162, 208, 324, 416',
                                id: thumbnail_id,
                                alt: media.alt
                                | escape
                            }}
                            {%- if is_video_thumbnail -%}
                                <span class="thumbnail__count-overlay">+{{ total_variant_videos | minus: 1 }}</span>
                            {%- endif -%}
                        </button>
                    </li>
                
            {%- endif -%}
        {%- endfor -%}
    {%- endif -%}
</ul>