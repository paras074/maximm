{% assign layout5 = product.metafields.custom.layout_five.value %}
<div class="page-width">

  {% if layout5.full_width_image_1 != blank %}
    <div class="full-width-img">

      {{
        layout5.full_width_image_1
        | image_url: width: 3840
        | image_tag:
          width: layout5.full_width_image_1.width,
          sizes: full_width,
          widths: widths
      }}        
    </div>
  {% endif %}

