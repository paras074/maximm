{% assign layout1 = product.metafields.custom.layout_one.value %}
<div class="page-width layout-one">
  {% if layout1.full_width_image_1 != blank %}
    <div class="full-width-img">

      {{
        layout1.full_width_image_1
        | image_url: width: 3840
        | image_tag:
          width: layout1.full_width_image_1.width,
          sizes: full_width,
          widths: widths
      }}        
    </div>
  {% endif %}
  {% if layout1.two_column_card_images != blank or layout1.two_column_card_titles != blank %}
    <div class="two-col-card-wrapper">
      {% if layout1.heading_for_two_column_section %}
        <h2 class="two-col-card-section-heading row-heading">{{ layout1.heading_for_two_column_section }}</h2>
      {% endif %}
      <div class="two-col-card-wrapper-inner">
        {% for item in layout1.two_column_card_images.value %}
          <div class="two-col-card-item">
            <div class="two-col-card-item-image">
              {{ item | image_url: width: 750 | image_tag }}
            </div>
            
            <h3 class="two-col-card-item-title col-heading">{{layout1.two_column_card_titles.value[forloop.index0 ] }}</h3>
            <div class="two-col-card-item-desc col-description">{{layout1.two_column_card_descriptions.value[forloop.index0 ] }}</div>
          </div> 
        {% endfor %} 
      </div>
    </div>
  {% endif %}
  
  {% if layout1.full_width_slider != blank %}
    <div class="full-width-slider swiper layout-banner-image-slider">
      <div class="swiper-wrapper"> 
        {% for item in layout1.full_width_slider.value %}
          <div class="swiper-slide full-width-slider-item">
            {{
              item
              | image_url: width: 3840
              | image_tag:
                width: item.width,
                sizes: full_width,
                widths: widths
            }}  
          </div>
        {% endfor %}
        <div class="swiper-button-next"></div>
        <div class="swiper-button-prev"></div>
      </div>   
      <div class="slider-titles">
        {% for item in layout1.full_width_slider.value %}
          <div class="slider-title">{{ item.alt }}</div>
        {% endfor %}
      </div>
    </div>
  {% endif %}
  
  {% if layout1.four_column_card_images != blank or layout1.four_column_card_titles != blank %}
    <div class="four-col-card-wrapper">
      {% if layout1.heading_for_four_column_section %}
        <h2 class="four-col-card-section-heading row-heading">{{ layout1.heading_for_four_column_section }}</h2>
      {% endif %}
      <div class="four-col-card-wrapper-inner">
        {% for item in layout1.four_column_card_images.value %}
          <div class="four-col-card-item">
            <div class="four-col-card-item-image">
              {{ item | image_url: width: 750 | image_tag }}
            </div>
            
            <h3 class="four-col-card-item-image col-heading">
              {{ layout1.four_column_card_titles.value[forloop.index0] }}
            </h3>
          </div> 
        {% endfor %} 
      </div>
    </div>
  {% endif %}
</div>
