{%- comment -%}
  "No products found" empty state for the collection grid. Shown both when the
  collection genuinely returns nothing and when every returned product is
  filtered out (e.g. an unmatchable taxonomy colour, or all sold out).
{%- endcomment -%}
<div class="collection-empty-state">
  <div class="collection-empty-state__icon" aria-hidden="true">
    <svg width="34" height="34" viewBox="0 0 24 24" fill="none">
      <path d="M3.5 7.2 12 3l8.5 4.2M3.5 7.2 12 11.4m-8.5-4.2v9.6L12 21m0-9.6 8.5-4.2m-8.5 4.2V21m8.5-13.8v9.6L12 21" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <circle cx="19.5" cy="18.5" r="4" fill="var(--empty-icon-bg, #fff)" stroke="currentColor" stroke-width="1.5"/>
      <path d="M22.4 21.4 25 24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>
  </div>
  <h2 class="collection-empty-state__title">
    {{ 'sections.collection_template.empty' | t | default: 'No products found' }}
  </h2>
  <p class="collection-empty-state__text">
    We couldn’t find anything matching those filters. Try removing one to see more results.
  </p>
  <a href="{{ collection.url }}" class="collection-empty-state__btn button button--primary">
    {% render 'icon-close-small' %}
    <span>Clear all filters</span>
  </a>
</div>
