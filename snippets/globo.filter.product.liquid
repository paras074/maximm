{%- comment -%}Do not edit this file{%- endcomment -%}
{% raw %}
  {%- assign swatch_options = 'Colour~~Color' | downcase | split: "~~" | uniq -%}
  {%- assign image_options  = '' | downcase | split: "~~" | uniq -%}
  {%- assign text_options   = 'Size' | downcase | split: "~~" | uniq  -%}

  {%- assign image_size     = '360x504' -%}
  {%- assign no_image = 'https://cdn.shopify.com/s/images/themes/product-1.png' -%}

  {%- assign featured_image            = product.featured_image -%}
  {%- assign product_price             = product.price -%}
  {%- assign product_compare_at_price  = product.compare_at_price -%}
  {%- assign selected_or_first_available_variant = product.selected_or_first_available_variant -%}
  {%- assign variant_url = '' -%}
  {%- assign variants_count = product.variants | size -%}
  {% assign lazy_load = false %}
  {%- if forloop.index > 2 -%}
    {%- assign lazy_load = true -%}
  {%- endif -%}

  {%- assign card_product = product -%} 
  {%- assign media_aspect_ratio = section.settings.image_ratio -%}
  {%- assign image_shape = section.settings.image_shape -%}
  {%- assign show_secondary_image = section.settings.show_secondary_image -%}
  {%- assign show_vendor = section.settings.show_vendor -%}
  {%- assign show_rating = section.settings.show_rating -%}
  {%- assign show_quick_add = section.settings.enable_quick_add -%}
  {%- assign section_id = section.id %}
  {%- assign collection_list = collection.metafields.custom.collection_product_features -%}

  {%- liquid
    assign ratio = 1
    if card_product.featured_image and media_aspect_ratio == 'portrait'
      assign ratio = 0.8
    elsif card_product.featured_image and media_aspect_ratio == 'adapt'
      assign ratio = card_product.featured_image.aspect_ratio
    endif
    if ratio == 0 or ratio == null
      assign ratio = 1
    endif
  -%}

  <li{% if showPageData %} data-page="{{page}}" {% endif %}
    class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
      style="--animation-order: {{ forloop.index }};"
    {% endif %}    
  >
    <div class="card-wrapper-horizontal-card card-wrapper product-card-wrapper underline-links-hover">
      <div class="card card--{{ settings.card_style }}{% if settings.card_style == 'card' %} color-{{ settings.card_color_scheme }} gradient{% endif %}">
        <div class="card__inner {% if settings.card_style == 'standard' %}color-{{ settings.card_color_scheme }} gradient{% endif %}{% if card_product.featured_image or settings.card_style == 'standard' %} ratio{% endif %}">
          <div class="atc">Add to Compare</div>  
          {%- if card_product.featured_image -%}
            <div class="card__media-collection">
              <div class="media-image media--transparent media--hover-effect">
                <span class="main-image">
                  {% if card_product.selected_or_first_available_variant.featured_image != blank %}
                    <img
                      srcset="
                        {%- if card_product.selected_or_first_available_variant.featured_image.width >= 165 -%}{{ card_product.selected_or_first_available_variant.featured_image | img_url: '165x' }} 165w,{%- endif -%}
                        {%- if card_product.selected_or_first_available_variant.featured_image.width >= 360 -%}{{ card_product.selected_or_first_available_variant.featured_image | img_url: '360x' }} 360w,{%- endif -%}
                        {%- if card_product.selected_or_first_available_variant.featured_image.width >= 533 -%}{{ card_product.selected_or_first_available_variant.featured_image | img_url: '533x' }} 533w,{%- endif -%}
                        {%- if card_product.selected_or_first_available_variant.featured_image.width >= 720 -%}{{ card_product.selected_or_first_available_variant.featured_image | img_url: '720x' }} 720w,{%- endif -%}
                        {%- if card_product.selected_or_first_available_variant.featured_image.width >= 940 -%}{{ card_product.selected_or_first_available_variant.featured_image | img_url: '940x' }} 940w,{%- endif -%}
                        {%- if card_product.selected_or_first_available_variant.featured_image.width >= 1066 -%}{{ card_product.selected_or_first_available_variant.featured_image | img_url: '1066x' }} 1066w,{%- endif -%}
                        {{ card_product.selected_or_first_available_variant.featured_image | image_url }} {{ card_product.selected_or_first_available_variant.featured_image.width }}w
                      "
                      src="{{ card_product.selected_or_first_available_variant.featured_image | img_url: '533x' }}"
                      sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                      alt="{{ card_product.selected_or_first_available_variant.featured_image.alt | escape }}"
                      class="motion-reduce"
                      {% unless lazy_load == false %}
                        loading="lazy"
                      {% endunless %}
                      width="{{ card_product.selected_or_first_available_variant.featured_image.width }}"
                      height="{{ card_product.selected_or_first_available_variant.featured_image.height }}"
                    >
                  {% else %}
                    <img
                      srcset="
                        {%- if card_product.featured_image.width >= 165 -%}{{ card_product.featured_image | img_url: '165x' }} 165w,{%- endif -%}
                        {%- if card_product.featured_image.width >= 360 -%}{{ card_product.featured_image | img_url: '360x' }} 360w,{%- endif -%}
                        {%- if card_product.featured_image.width >= 533 -%}{{ card_product.featured_image | img_url: '533x' }} 533w,{%- endif -%}
                        {%- if card_product.featured_image.width >= 720 -%}{{ card_product.featured_image | img_url: '720x' }} 720w,{%- endif -%}
                        {%- if card_product.featured_image.width >= 940 -%}{{ card_product.featured_image | img_url: '940x' }} 940w,{%- endif -%}
                        {%- if card_product.featured_image.width >= 1066 -%}{{ card_product.featured_image | img_url: '1066x' }} 1066w,{%- endif -%}
                        {{ card_product.featured_image | image_url }} {{ card_product.featured_image.width }}w
                      "
                      src="{{ card_product.featured_image | img_url: '533x' }}"
                      sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                      alt="{{ card_product.featured_image.alt | escape }}"
                      class="motion-reduce"
                      {% unless lazy_load == false %}
                        loading="lazy"
                      {% endunless %}
                      width="{{ card_product.featured_image.width }}"
                      height="{{ card_product.featured_image.height }}"
                    >
                  {% endif %}
                </span>
                
                {% comment %}theme-check-enable ImgLazyLoading{% endcomment %}
                {%- if card_product.images[1] != null -%}
                  <span class="secondary-image">
                    <img
                      srcset="
                        {%- if card_product.images[1].width >= 165 -%}{{ card_product.images[1] | img_url: '165x' }} 165w,{%- endif -%}
                        {%- if card_product.images[1].width >= 360 -%}{{ card_product.images[1] | img_url: '360x' }} 360w,{%- endif -%}
                        {%- if card_product.images[1].width >= 533 -%}{{ card_product.images[1] | img_url: '533x' }} 533w,{%- endif -%}
                        {%- if card_product.images[1].width >= 720 -%}{{ card_product.images[1] | img_url: '720x' }} 720w,{%- endif -%}
                        {%- if card_product.images[1].width >= 940 -%}{{ card_product.images[1] | img_url: '940x' }} 940w,{%- endif -%}
                        {%- if card_product.images[1].width >= 1066 -%}{{ card_product.images[1] | img_url: '1066x' }} 1066w,{%- endif -%}
                        {{ card_product.images[1] | image_url }} {{ card_product.images[1].width }}w
                      "
                      src="{{ card_product.images[1] | img_url: '533x' }}"
                      sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                      alt=""
                      class="motion-reduce"
                      loading="lazy"
                      width="{{ card_product.images[1].width }}"
                      height="{{ card_product.images[1].height }}"
                    >
                  </span>
                  
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>

        <div class="card__content">
          <div class="heading-wrapper">
            <div class="heading">
              <h3 class="card__heading">
                <a href="{{ card_product.url | within: collection }}?variant={{ card_product.first_available_variant.id }}"
                  class="full-unstyled-link"
                  aria-labelledby="CardLink-{{ section_id }}-{{ card_product.id }} Badge-{{ section_id }}-{{ card_product.id }}">
                  {{ card_product.title | escape }}

                  {% if card_product.selected_or_first_available_variant.option1 != blank %}
                    <span class="option-one-value">{{ card_product.selected_or_first_available_variant.option1 | prepend: ' - ' }}</span>
                  {% endif %}
                  {% if card_product.selected_or_first_available_variant.option2 != blank %}
                    <span class="option-two-value">{{ card_product.selected_or_first_available_variant.option2 | prepend: ' - ' }}</span>
                  {% endif %}
                  {% if card_product.selected_or_first_available_variant.option3 != blank %}
                    <span class="option-three-value">{{ card_product.selected_or_first_available_variant.option3 | prepend: ' - ' }}</span>
                  {% endif %}
                </a>
              </h3>
              <div class="sku">{{ card_product.selected_or_first_available_variant.sku }}</div>
            </div>
            <div class="widhlist-plp-wrapper">
              <button class='st-wishlist-button' data-type='details' data-handle='{{ card_product.handle }}'></button>
            </div>
          </div>
          <div class="card-review">
          <div class='areviews_product_item areviews_stars{{ card_product.id }}' data-product-id='{{ card_product.id }}'></div> 
          </div>

          <div class="bullet-points-insert"></div>

          <div class="card-information">
            {%- if show_vendor -%}
              <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
              <div class="caption-with-letter-spacing light">{{ card_product.vendor }}</div>
            {%- endif -%}
            <spark-pdp parent-id="{{ card_product.id }}"></spark-pdp>

            <span class="caption-large light">{{ block.settings.description | escape }}</span>

            {%- assign product_form_id = 'product-form-' | append: section_id | append: product.id -%}
            
            {%- unless product.variants.size < 1 -%}
            {% assign selected_variant = product.first_available_variant %}
              <variant-selects class="collection-product-variant" data-url="{{ product.url }}" data-update-url="false" {{ block.shopify_attributes }}>
                {% assign selected_variant = product.first_available_variant %}

                <div class="product-options">
                  {% for option_index in (0..product.options.size) %}
                    {% assign option_name = product.options[option_index].name %}
                    {% assign values = '' %}

                    {%- for variant in product.variants -%}
                    {{ variant | json }}<br><br>
                      {% assign option_value = variant.name[option_index] %}
                      {% unless values contains option_value %}
                        {% assign values = values | append: option_value | append: '||' %}
                      {% endunless %}
                    {%- endfor -%}

                    {% assign values_array = values | split: '||' | uniq %}
                    {% assign values_array = values_array | reject: '' %}

                    {% assign selected_value = selected_variant["option" | append: option_index] %}
                    <div class="option-block">
                      <strong>{{ option_name }}</strong>
                      <div class="option-values">
                        {% for val in values_array %}
                        Array Value: 
                          <div class="option-value-block{% if val == selected_value %} selected{% endif %}">
                            {{ val }}
                          </div>
                        {% endfor %}
                      </div>
                    </div>
                  {% endfor %}
                </div>

                {% comment %} {%- for option in product.options_with_values -%}
                    <fieldset class="collection-js product-form__input product-form__input--pill swiper swiper-updater-collection">
                      <legend class="form__label">{{ option.name }}: {{- option.selected_value -}}</legend>
                        <div class="swiper-wrapper">
                          {% render 'product-variant-options-col',
                            product: product,
                            option: option,
                            picker_type: picker_type
                          %}
                        </div>
                        {% if option.values.size > 6 %}
                          <div class="button-prev">
                            {% render 'icon-caret' %}
                          </div>
                          <div class="button-next">
                            {% render 'icon-caret' %}
                          </div>
                        {% endif %}
                    </fieldset>
                {%- endfor -%} {% endcomment %}
                <script type="application/json" data-collection-variant>
                  {{ product.variants | json }}
                </script>
              </variant-selects>
            {%- endunless -%}
            
          </div>
        </div>
      </div>
    </div>
  </li>
{% endraw %}