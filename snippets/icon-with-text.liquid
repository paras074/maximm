
{%- liquid
  assign metaobject_items = product.metafields.custom.icon_with_text.value
-%}
{%- if block.settings.enable_icon_with_text -%}
{%- if metaobject_items != blank -%}

  <ul
    class="icon-with-text single-product icon-with-text--{{ block.settings.layout }} list-unstyled"
    {{ block.shopify_attributes }}
  >
    {%- for item in metaobject_items limit: 4  -%}
      {%- if item.text != blank -%}
        <li class="icon-with-text__item">
          {%- if item.image != blank -%}
            <img
              src="{{ item.image | image_url: width: 100 }}"
              alt="{{ item.image.alt | default: item.text | escape }}"
              width="{{ item.image.width }}"
              height="{{ item.image.height }}"
              loading="lazy"
            >
          {%- endif -%}
          <div class="icon-with-text__item_inner">
            <span class="PwsTextwrap">
              {{ item.text }}
            </span>
            <span class="PwsSUb-heading">
            {{item.sub_heading }}  
            </span>
          </div> 
          
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>

{%- else -%}

  {%- liquid

    assign heading_1_empty = false
    assign heading_2_empty = false
    assign heading_3_empty = false
    assign text_only_all_items = true

    if block.settings.heading_1 == blank
      assign heading_1_empty = true
    endif

    if block.settings.heading_2 == blank
      assign heading_2_empty = true
    endif

    if block.settings.heading_3 == blank
      assign heading_3_empty = true
    endif

    if heading_1_empty == false and block.settings.icon_1 != 'none'
      assign text_only_all_items = false
    endif

    if heading_2_empty == false and block.settings.icon_2 != 'none'
      assign text_only_all_items = false
    endif

    if heading_3_empty == false and block.settings.icon_3 != 'none'
      assign text_only_all_items = false
    endif

    if block.settings.image_1 != blank
      assign text_only_all_items = false
    endif

    if block.settings.image_2 != blank
      assign text_only_all_items = false
    endif

    if block.settings.image_3 != blank
      assign text_only_all_items = false
    endif

    if block.settings.image_4 != blank
      assign text_only_all_items = false
    endif

  -%}
  <ul
    class="icon-with-text single-product icon-with-text--{{ block.settings.layout }} list-unstyled{% if text_only_all_items %} icon-with-text--text-only{% endif %}"
    {{ block.shopify_attributes }}
  >

    {%- unless heading_1_empty -%}
      <li class="icon-with-text__item">
        {%- if block.settings.image_1 == blank -%}
          {%- render 'icon-accordion',
            icon: block.settings.icon_1
          -%}
        {%- else -%}
          <img
            src="{{ block.settings.image_1 | image_url }}"
            {% if block.settings.image_1.alt != blank %}
              alt="{{ block.settings.image_1.alt | escape }}"
            {% else %}
              role="presentation"
            {% endif %}
            height="auto"
            width="auto"
            loading="lazy"
          >
        {%- endif -%}
        <span class="h4 inline-richtext">
          {{- block.settings.heading_1 -}}
        </span>
      </li>

    {%- endunless -%}
    {%- unless heading_2_empty -%}
      <li class="icon-with-text__item">
        {%- if block.settings.image_2 == blank -%}
          {%- render 'icon-accordion',
            icon: block.settings.icon_2
          -%}
        {%- else -%}
          <img
            src="{{ block.settings.image_2 | image_url }}"
            {% if block.settings.image_2.alt != blank %}
              alt="{{ block.settings.image_2.alt | escape }}"
            {% else %}
              role="presentation"
            {% endif %}
            height="auto"
            width="auto"
            loading="lazy"
        >
        {%- endif -%}
       <span class="h4 inline-richtext">
          {{- block.settings.heading_2 -}}
        </span>
      </li>
    {%- endunless -%}

    {%- unless heading_3_empty -%}
      <li class="icon-with-text__item">
        {%- if block.settings.image_3 == blank -%}
          {%- render 'icon-accordion',
            icon: block.settings.icon_3
          -%}
        {%- else -%}
          <img
            src="{{ block.settings.image_3 | image_url }}"
            {% if block.settings.image_3.alt != blank %}
              alt="{{ block.settings.image_3.alt | escape }}"
            {% else %}
              role="presentation"
            {% endif %}
            height="auto"
            width="auto"
            loading="lazy"
          >
        {%- endif -%}
        <span class="h4 inline-richtext">
          {{- block.settings.heading_3 -}}
        </span>
      </li>
    {%- endunless -%}

    {%- unless block.settings.heading_4 == blank -%}
      <li class="icon-with-text__item">
        {%- if block.settings.image_4 != blank -%}
          <img
            src="{{ block.settings.image_4 | image_url }}"
            alt="{{ block.settings.image_4.alt | escape }}"
            width="{{ block.settings.image_4.width }}"
            height="{{ block.settings.image_4.height }}"
            loading="lazy"
          >
        {%- else -%}
          {%- render 'icon-accordion',
            icon: block.settings.icon_4
          -%}
        {%- endif -%}
        <span class="h4 inline-richtext">
          {{- block.settings.heading_4 -}}
        </span>
      </li>
    {%- endunless -%}
  </ul>
{%- endif -%}

{%- endif -%}