{% assign layout2 = product.metafields.custom.layout_two.value %}
<div class="page-width layout-two">
  {% if layout2.full_width_image_1 != blank %}
    <div class="full-width-img">

      {{
        layout2.full_width_image_1
        | image_url: width: 3840
        | image_tag:
          width: layout2.full_width_image_1.width,
          sizes: full_width,
          widths: widths
      }}        
    </div>
  {% endif %}
  {% if layout2.full_width_image_2 != blank %}
    <div class="full-width-img">

      {{
        layout2.full_width_image_2
        | image_url: width: 3840
        | image_tag:
          width: layout2.full_width_image_2.width,
          sizes: full_width,
          widths: widths
      }}        
    </div>
  {% endif %}  

  {% if layout2.four_column_card_images != blank or layout2.four_column_card_titles != blank %}
    <div class="four-col-card-wrapper">
      <div class="four-col-card-wrapper-inner">
        {% for item in layout2.four_column_card_images.value %}
          <div class="four-col-card-item">
            <div class="four-col-card-item-image">
              {{ item | image_url: width: 750 | image_tag }}
            </div>
            
            <h3 class="four-col-card-item-image col-heading">
              {{ layout2.four_column_card_titles.value[forloop.index0] }}
            </h3>
            <div class="four-col-card-item-desc col-description">{{layout2.four_column_card_descriptions.value[forloop.index0 ] }}</div>
          </div> 
        {% endfor %} 
      </div>
    </div>
  {% endif %}

  {% if layout2.full_width_slider != blank %}
    <div class="full-width-slider swiper layout-banner-image-slider">
      <div class="swiper-wrapper"> 
        {% for item in layout2.full_width_slider.value %}
          <div class="swiper-slide full-width-slider-item">
            {{
              item
              | image_url: width: 3840
              | image_tag:
                width: item.width,
                sizes: full_width,
                widths: widths
            }}  
          </div>
        {% endfor %}
        <div class="swiper-button-next"></div>
        <div class="swiper-button-prev"></div>
      </div>   
      <div class="swiper-pagination"></div>
    </div>
  {% endif %}
</div>
