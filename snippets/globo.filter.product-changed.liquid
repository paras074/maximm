{%- comment -%}Do not edit this file{%- endcomment -%}
{% raw %}
  {%- assign swatch_options = 'Colour~~Color' | downcase | split: "~~" | uniq -%}
  {%- assign image_options  = '' | downcase | split: "~~" | uniq -%}
  {%- assign text_options   = 'Size' | downcase | split: "~~" | uniq  -%}

  {%- assign image_size     = '360x504' -%}
  {%- assign no_image = 'https://cdn.shopify.com/s/images/themes/product-1.png' -%}

  {%- assign featured_image            = product.featured_image -%}
  {%- assign product_price             = product.price -%}
  {%- assign product_compare_at_price  = product.compare_at_price -%}
  {%- assign selected_or_first_available_variant = product.selected_or_first_available_variant -%}
  {%- assign variant_url = '' -%}
                              {%- assign variants_count = product.variants | size -%}
  {% assign lazy_load = false %}
  {%- if forloop.index > 2 -%}
    {%- assign lazy_load = true -%}
  {%- endif -%}

  {%- assign card_product = product -%} 
  {%- assign media_aspect_ratio = section.settings.image_ratio -%}
  {%- assign image_shape = section.settings.image_shape -%}
  {%- assign show_secondary_image = section.settings.show_secondary_image -%}
  {%- assign show_vendor = section.settings.show_vendor -%}
  {%- assign show_rating = section.settings.show_rating -%}
  {%- assign show_quick_add = section.settings.enable_quick_add -%}
  {%- assign section_id = section.id %}

  {%- liquid
    assign ratio = 1
    if card_product.featured_image and media_aspect_ratio == 'portrait'
      assign ratio = 0.8
    elsif card_product.featured_image and media_aspect_ratio == 'adapt'
      assign ratio = card_product.featured_image.aspect_ratio
    endif
    if ratio == 0 or ratio == null
      assign ratio = 1
    endif
  -%}

  <li{% if showPageData %} data-page="{{page}}" {% endif %}
    class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
      style="--animation-order: {{ forloop.index }};"
    {% endif %}    
  >
    <div class="card-wrapper-horizontal-card card-wrapper product-card-wrapper underline-links-hover">
    <div class="card card--{{ settings.card_style }}{% if settings.card_style == 'card' %} color-{{ settings.card_color_scheme }} gradient{% endif %}">
      <div class="card__inner {% if settings.card_style == 'standard' %}color-{{ settings.card_color_scheme }} gradient{% endif %}{% if card_product.featured_media or settings.card_style == 'standard' %} ratio{% endif %}">
        <div class="atc">Add to Compare</div>
        {%- if card_product.featured_media -%}
          <div class="card__media-collection">
            <div class="media-image media--transparent media--hover-effect">
              {% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
              <span class="main-image">
                {% if card_product.selected_or_first_available_variant.featured_media != blank %}
                  <img
                    srcset="
                      {%- if card_product.selected_or_first_available_variant.featured_media.width >= 165 -%}{{ card_product.selected_or_first_available_variant.featured_media | image_url: width: 165 }} 165w,{%- endif -%}
                      {%- if card_product.selected_or_first_available_variant.featured_media.width >= 360 -%}{{ card_product.selected_or_first_available_variant.featured_media | image_url: width: 360 }} 360w,{%- endif -%}
                      {%- if card_product.selected_or_first_available_variant.featured_media.width >= 533 -%}{{ card_product.selected_or_first_available_variant.featured_media | image_url: width: 533 }} 533w,{%- endif -%}
                      {%- if card_product.selected_or_first_available_variant.featured_media.width >= 720 -%}{{ card_product.selected_or_first_available_variant.featured_media | image_url: width: 720 }} 720w,{%- endif -%}
                      {%- if card_product.selected_or_first_available_variant.featured_media.width >= 940 -%}{{ card_product.selected_or_first_available_variant.featured_media | image_url: width: 940 }} 940w,{%- endif -%}
                      {%- if card_product.selected_or_first_available_variant.featured_media.width >= 1066 -%}{{ card_product.selected_or_first_available_variant.featured_media | image_url: width: 1066 }} 1066w,{%- endif -%}
                      {{ card_product.selected_or_first_available_variant.featured_media | image_url }} {{ card_product.selected_or_first_available_variant.featured_media.width }}w
                    "
                    src="{{ card_product.selected_or_first_available_variant.featured_media | image_url: width: 533 }}"
                    sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                    alt="{{ card_product.selected_or_first_available_variant.featured_media.alt | escape }}"
                    class="motion-reduce"
                    {% unless lazy_load == false %}
                      loading="lazy"
                    {% endunless %}
                    width="{{ card_product.selected_or_first_available_variant.featured_media.width }}"
                    height="{{ card_product.selected_or_first_available_variant.featured_media.height }}"
                  >
                {% else %}
                  <img
                    srcset="
                      {%- if card_product.featured_media.width >= 165 -%}{{ card_product.featured_media | image_url: width: 165 }} 165w,{%- endif -%}
                      {%- if card_product.featured_media.width >= 360 -%}{{ card_product.featured_media | image_url: width: 360 }} 360w,{%- endif -%}
                      {%- if card_product.featured_media.width >= 533 -%}{{ card_product.featured_media | image_url: width: 533 }} 533w,{%- endif -%}
                      {%- if card_product.featured_media.width >= 720 -%}{{ card_product.featured_media | image_url: width: 720 }} 720w,{%- endif -%}
                      {%- if card_product.featured_media.width >= 940 -%}{{ card_product.featured_media | image_url: width: 940 }} 940w,{%- endif -%}
                      {%- if card_product.featured_media.width >= 1066 -%}{{ card_product.featured_media | image_url: width: 1066 }} 1066w,{%- endif -%}
                      {{ card_product.featured_media | image_url }} {{ card_product.featured_media.width }}w
                    "
                    src="{{ card_product.featured_media | image_url: width: 533 }}"
                    sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                    alt="{{ card_product.featured_media.alt | escape }}"
                    class="motion-reduce"
                    {% unless lazy_load == false %}
                      loading="lazy"
                    {% endunless %}
                    width="{{ card_product.featured_media.width }}"
                    height="{{ card_product.featured_media.height }}"
                  >
                {% endif %}
              </span>
              
              {% comment %}theme-check-enable ImgLazyLoading{% endcomment %}
              {%- if card_product.media[1] != null -%}
                <span class="secondary-image">
                  <img
                    srcset="
                      {%- if card_product.media[1].width >= 165 -%}{{ card_product.media[1] | image_url: width: 165 }} 165w,{%- endif -%}
                      {%- if card_product.media[1].width >= 360 -%}{{ card_product.media[1] | image_url: width: 360 }} 360w,{%- endif -%}
                      {%- if card_product.media[1].width >= 533 -%}{{ card_product.media[1] | image_url: width: 533 }} 533w,{%- endif -%}
                      {%- if card_product.media[1].width >= 720 -%}{{ card_product.media[1] | image_url: width: 720 }} 720w,{%- endif -%}
                      {%- if card_product.media[1].width >= 940 -%}{{ card_product.media[1] | image_url: width: 940 }} 940w,{%- endif -%}
                      {%- if card_product.media[1].width >= 1066 -%}{{ card_product.media[1] | image_url: width: 1066 }} 1066w,{%- endif -%}
                      {{ card_product.media[1] | image_url }} {{ card_product.media[1].width }}w
                    "
                    src="{{ card_product.media[1] | image_url: width: 533 }}"
                    sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                    alt=""
                    class="motion-reduce"
                    loading="lazy"
                    width="{{ card_product.media[1].width }}"
                    height="{{ card_product.media[1].height }}"
                  >
                </span>
                
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
        <div class="quick-view">
          {%- if show_quick_add -%}
            <div class="quick-add no-js-hidden">
              {%- liquid
                assign product_form_id_quick = 'quick-add-' | append: section_id | append: card_product.id
                assign qty_rules = false
                if card_product.selected_or_first_available_variant.quantity_rule.min > 1 or card_product.selected_or_first_available_variant.quantity_rule.max != null or card_product.selected_or_first_available_variant.quantity_rule.increment > 1
                  assign qty_rules = true
                endif
              -%}
              {%- if card_product.variants.size > 1 or qty_rules -%}
                <modal-opener data-modal="#QuickAdd-{{ card_product.id }}">
                  <button
                    id="{{ product_form_id_quick }}-submit"
                    type="submit"
                    name="add"
                    class="quick-add__submit link"
                    aria-haspopup="dialog"
                    aria-labelledby="{{ product_form_id_quick }}-submit title-{{ section_id }}-{{ card_product.id }}"
                    data-product-url="{{ card_product.url }}"
                  >
                    <span class="icon-wrap">
                      {% render 'icon-quick-look' %}
                    </span>
                    <span>Quick Look</span>
                    {%- render 'loading-spinner' -%}
                  </button>
                </modal-opener>
                <quick-add-modal id="QuickAdd-{{ card_product.id }}" class="quick-add-modal">
                  <div
                    role="dialog"
                    aria-label="{{ 'products.product.choose_product_options' | t: product_name: card_product.title | escape }}"
                    aria-modal="true"
                    class="quick-add-modal__content global-settings-popup"
                    tabindex="-1"
                  >
                    <button
                      id="ModalClose-{{ card_product.id }}"
                      type="button"
                      class="quick-add-modal__toggle"
                      aria-label="{{ 'accessibility.close' | t }}"
                    >
                      {% render 'icon-close' %}
                    </button>
                    <div id="QuickAddInfo-{{ card_product.id }}" class="quick-add-modal__content-info"></div>
                  </div>
                </quick-add-modal>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
      <div class="card__content">
        <div class="heading-wrapper">
          <div class="heading">
            <h3 class="card__heading">
              <a href="{{ card_product.url | within: collection }}"
                class="full-unstyled-link"
                aria-labelledby="CardLink-{{ section_id }}-{{ card_product.id }} Badge-{{ section_id }}-{{ card_product.id }}">
                {{ card_product.title | escape }}
                {% if card_product.selected_or_first_available_variant.option1 != blank %}
                  <span class="option-one-value">{{ card_product.selected_or_first_available_variant.option1 | prepend: ' - ' }}</span>
                {% endif %}
                {% if card_product.selected_or_first_available_variant.option2 != blank %}
                  <span class="option-two-value">{{ card_product.selected_or_first_available_variant.option2 | prepend: ' - ' }}</span>
                {% endif %}
                {% if card_product.selected_or_first_available_variant.option3 != blank %}
                  <span class="option-three-value">{{ card_product.selected_or_first_available_variant.option3 | prepend: ' - ' }}</span>
                {% endif %}
              </a>
            </h3>
            <div class="sku">{{ card_product.selected_or_first_available_variant.sku }}</div>
          </div>
          <div class="widhlist-plp-wrapper">
            <button class='st-wishlist-button' data-type='details' data-handle='{{ card_product.handle }}'></button>
          </div>
        </div>
        <div class="card-review">
         <div class='areviews_product_item areviews_stars{{ card_product.id }}' data-product-id='{{ card_product.id }}'></div> 
        </div>
        {% if product.metafields.custom.bullet_points != blank %}
          <div class="bullet-points">
            <ul class="product-bullet-point">
            {% for point in product.metafields.custom.bullet_points.value %}
              <li class="point">
                  <a href="javascript: void(0)" class="feat-btn">
                    {% if point.icon_image != blank %}
                      <span class="ico">{{ point.icon_image | image_url: width: 50, height: 50 | image_tag }}</span>
                    {% endif %}
                    <span class="txt">{{ point.title }}</span>
                  </a>

                  <div class="feature-meta-wrap">
                    <span class="close-btn">{%  render 'icon-close' %}</span>
                    <h5 class="h4">{{ point.title }}</h5>
                    <div class="feature-meta">
                      {% if point.feature_image != blank %}
                        <div class="feature-thumb">{{ point.feature_image | image_url: width: 232, height: 232 | image_tag }}</div>
                      {% endif %}
                      {% if point.feature_description != blank %}
                        <div class="feature-desc">
                          {{ point.feature_description |  metafield_tag}}
                        </div>
                      {% endif %}
                    </div>
                  </div>
                </li>
            {% endfor %}
            </ul>
          </div>
        {% elsif collection_list != blank %}
          <div class="bullet-points">
            <ul class="product-bullet-point">
            {% for point in collection_list.value %}
              <li class="point">
                  {% if point.icon_image != blank %}
                    <span class="ico">{{ point.icon_image | image_url: width: 50, height: 50 | image_tag }}</span>
                  {% endif %}
                  <span class="txt">{{ point.title }}</span>
                </li>
            {% endfor %}
            </ul>
          </div>
        {% endif %}
        <div class="card-information">
          {%- if show_vendor -%}
            <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
            <div class="caption-with-letter-spacing light">{{ card_product.vendor }}</div>
          {%- endif -%}

         <spark-pdp parent-id="{{ card_product.id }}"></spark-pdp>

          <span class="caption-large light">{{ block.settings.description | escape }}</span>

          {%- if card_product.quantity_price_breaks_configured? -%}
            <div class="card__information-volume-pricing-note">
              <span class="caption">{{ 'products.product.volume_pricing.note' | t }}</span>
            </div>
          {%- endif -%}
          {%- assign product_form_id = 'product-form-' | append: section_id | append: forloop_index -%}

          {%- unless product.has_only_default_variant -%}
            <variant-selects class="collection-product-variant" data-url="{{ product.url }}" data-update-url="false" {{ block.shopify_attributes }}>
              {%- for option in product.options_with_values -%}
                {%- liquid
                  assign swatch_count = option.values | map: 'swatch' | compact | size
                  assign picker_type = 'button'
          
                  if swatch_count > 0 and block.settings.swatch_shape != 'none'
                      assign picker_type = 'swatch'
                  endif
                -%}
                {%- if picker_type == 'swatch' -%}
                  <fieldset class="collection-js product-form__input product-form__input--swatch">
                    <legend class="form__label">
                      {{ option.name }}:
                      <span data-selected-swatch-value="{{ option.name }}">
                        {{- option.selected_value -}}
                      </span>
                    </legend>
                    {% render 'product-variant-options-col',
                      product: product,
                      option: option,
                      picker_type: picker_type
                    %}
                  </fieldset>
                {%- elsif picker_type == 'button' -%}
                  <fieldset class="collection-js product-form__input product-form__input--pill swiper swiper-updater-collection">
                    <legend class="form__label">{{ option.name }}: {{- option.selected_value -}}</legend>
                      <div class="swiper-wrapper">
                        {% render 'product-variant-options-col',
                          product: product,
                          option: option,
                          picker_type: picker_type
                        %}
                      </div>
                      {% if option.values.size > 6 %}
                        <div class="button-prev">
                          {% render 'icon-caret' %}
                        </div>
                        <div class="button-next">
                          {% render 'icon-caret' %}
                        </div>
                      {% endif %}
                  </fieldset>
                {%- endif -%}
              {%- endfor -%}
              <script type="application/json" data-collection-variant>
                {{ product.variants | json }}
              </script>
            </variant-selects>
          {%- endunless -%}

          {%- render 'buy-buttons-collection-card',
              product: card_product,
              product_form_id: product_form_id,
              section_id: section_id,
              show_pickup_availability: false
          -%}
        </div>
      </div>
    </div>
  </div>
  </div>
  </li>
{% endraw %}