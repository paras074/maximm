<script>
    var klaviyo = klaviyo || [];
    klaviyo.init({
      account: "Srw7pw",
      platform: "shopify",
      collection_urls: ["/collections/"]
    });
    klaviyo.enable("backinstock",{
    trigger: {
      product_page_text: "Notify Me When Available",
      product_page_class: "button",
      product_page_text_align: "center",
      product_page_margin: "0px",
      replace_anchor: true
    },
    modal: {
     headline: "{product_name}",
     body_content: "Register to receive a notification when this item comes back in stock.",
     email_field_label: "Email",
     button_label: "Notify me when available",
     subscription_success_label: "You're in! We'll let you know when it's back.",
     footer_content: '',
     additional_styles: "@import url('https://fonts.googleapis.com/css?family=Helvetica+Neue');",
     drop_background_color: "#000",
     background_color: "#fff",
     text_color: "#222",
     button_text_color: "#fff",
     button_background_color: "#439fdb",
     close_button_color: "#ccc",
     error_background_color: "#fcd6d7",
     error_text_color: "#C72E2F",
     success_background_color: "#d3efcd",
     success_text_color: "#1B9500"
    }
  });

  // Custom Klaviyo BIS Modal for Collection Pages
  (function() {
    var KLAVIYO_COMPANY_ID = 'Srw7pw';
    var modal = null;
    var currentBtn = null;

    function createModal() {
      var div = document.createElement('div');
      div.id = 'klaviyo-bis-modal';
      div.style.display = 'none';
      div.innerHTML =
        '<div class="klaviyo-bis-overlay" style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:99999;display:flex;align-items:center;justify-content:center;">' +
          '<div style="background:#fff;padding:30px;border-radius:8px;max-width:420px;width:90%;position:relative;font-family:Helvetica Neue,Arial,sans-serif;">' +
            '<button class="klaviyo-bis-close" style="position:absolute;top:10px;right:15px;border:none;background:none;font-size:28px;cursor:pointer;color:#ccc;line-height:1;">&times;</button>' +
            '<h3 class="klaviyo-bis-title" style="margin:0 0 8px;font-size:20px;color:#222;font-weight:600;"></h3>' +
            '<p style="margin:0 0 20px;color:#666;font-size:14px;">Register to receive a notification when this item comes back in stock.</p>' +
            '<form class="klaviyo-bis-form">' +
              '<label style="display:block;margin-bottom:15px;">' +
                '<span style="display:block;margin-bottom:5px;font-size:14px;color:#222;">Variant</span>' +
                '<select class="klaviyo-bis-variant" style="width:100%;padding:12px;border:1px solid #ccc;border-radius:4px;font-size:14px;box-sizing:border-box;"></select>' +
              '</label>' +
              '<label style="display:block;margin-bottom:15px;">' +
                '<span style="display:block;margin-bottom:5px;font-size:14px;color:#222;">Email</span>' +
                '<input type="email" class="klaviyo-bis-email" placeholder="Enter your email" required style="width:100%;padding:12px;border:1px solid #ccc;border-radius:4px;font-size:14px;box-sizing:border-box;">' +
              '</label>' +
              '<button type="submit" class="klaviyo-bis-submit" style="width:100%;padding:14px;background:#439fdb;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:16px;font-weight:600;">Notify me when available</button>' +
            '</form>' +
            '<p class="klaviyo-bis-success" style="display:none;background:#d3efcd;color:#1B9500;padding:15px;border-radius:4px;margin:20px 0 0;text-align:center;font-size:14px;">You\'re in! We\'ll let you know when it\'s back.</p>' +
            '<p class="klaviyo-bis-error" style="display:none;background:#fcd6d7;color:#C72E2F;padding:15px;border-radius:4px;margin:20px 0 0;text-align:center;font-size:14px;"></p>' +
          '</div>' +
        '</div>';
      document.body.appendChild(div);
      return div;
    }

    function openModal(btn) {
      if (!modal) modal = createModal();
      currentBtn = btn;

      var productTitle = btn.getAttribute('data-product-title') || 'This product';
      var selectedVariant = btn.getAttribute('data-selected-variant');
      var allVariants = [];
      var oosVariants = [];

      try {
        allVariants = JSON.parse(btn.getAttribute('data-product-variants') || '[]');
        // Filter only out-of-stock variants
        oosVariants = allVariants.filter(function(v) {
          return !v.available;
        });
      } catch(e) {
        console.error('Error parsing variants:', e);
        oosVariants = [];
      }

      // Set title
      modal.querySelector('.klaviyo-bis-title').textContent = productTitle;

      // Populate variant dropdown
      var select = modal.querySelector('.klaviyo-bis-variant');
      select.innerHTML = '';
      oosVariants.forEach(function(v) {
        var opt = document.createElement('option');
        opt.value = v.id;
        opt.textContent = v.title;
        if (String(v.id) === String(selectedVariant)) opt.selected = true;
        select.appendChild(opt);
      });

      // Reset form state
      modal.querySelector('.klaviyo-bis-form').style.display = 'block';
      modal.querySelector('.klaviyo-bis-success').style.display = 'none';
      modal.querySelector('.klaviyo-bis-error').style.display = 'none';
      modal.querySelector('.klaviyo-bis-email').value = '';
      modal.style.display = 'block';
    }

    function closeModal() {
      if (modal) modal.style.display = 'none';
    }

    function submitBIS(email, variantId) {
      return fetch('https://a.klaviyo.com/client/back-in-stock-subscriptions/?company_id=' + KLAVIYO_COMPANY_ID, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'revision': '2024-10-15' },
        body: JSON.stringify({
          data: {
            type: 'back-in-stock-subscription',
            attributes: {
              channels: ['EMAIL'],
              profile: { data: { type: 'profile', attributes: { email: email } } }
            },
            relationships: {
              variant: { data: { type: 'catalog-variant', id: '$shopify:::$default:::' + variantId } }
            }
          }
        })
      });
    }

    // Event listeners
    document.addEventListener('click', function(e) {
      var btn = e.target.closest('.klaviyo-bis-custom');
      if (btn) {
        e.preventDefault();
        openModal(btn);
        return;
      }
      if (e.target.closest('.klaviyo-bis-close') || e.target.classList.contains('klaviyo-bis-overlay')) {
        closeModal();
      }
    });

    document.addEventListener('submit', function(e) {
      if (e.target.classList.contains('klaviyo-bis-form')) {
        e.preventDefault();
        var email = modal.querySelector('.klaviyo-bis-email').value;
        var variantId = modal.querySelector('.klaviyo-bis-variant').value;
        var submitBtn = modal.querySelector('.klaviyo-bis-submit');
        var form = modal.querySelector('.klaviyo-bis-form');
        var successMsg = modal.querySelector('.klaviyo-bis-success');
        var errorMsg = modal.querySelector('.klaviyo-bis-error');

        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting...';

        submitBIS(email, variantId)
          .then(function(response) {
            if (response.ok || response.status === 202) {
              form.style.display = 'none';
              successMsg.style.display = 'block';
            } else {
              throw new Error('Failed');
            }
          })
          .catch(function() {
            errorMsg.textContent = 'Something went wrong. Please try again.';
            errorMsg.style.display = 'block';
          })
          .finally(function() {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Notify me when available';
          });
      }
    });
  })();
  (function () {
    if (window.location.pathname !== "/") return;

    function moveReviewer() {
        document.querySelectorAll(".jdgm-card.jdgm-media-card").forEach(function (card) {

            const text = card.querySelector(".jdgm-text");
            const reviewer = card.querySelector(".jdgm-reviewer-info");

            if (!text || !reviewer) return;

            // Already in correct place
            if (reviewer.previousElementSibling === text) return;

            text.insertAdjacentElement("afterend", reviewer);
        });
    }

    // Run every 500ms until cards exist
    const interval = setInterval(function () {
        moveReviewer();

        if (document.querySelector(".jdgm-card.jdgm-media-card")) {
            clearInterval(interval);
        }
    }, 500);

    // Observe the whole document for Judge.me updates
    new MutationObserver(moveReviewer).observe(document.body, {
        childList: true,
        subtree: true
    });
})();
</script>
  </body>
