{%- style -%}
  {{ section.settings.title_font | font_face: font_display: 'swap' }}
  {{ section.settings.body_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} .hero-wrapper {
    width: 100%;
    background: {{ section.settings.bg_color }};
    display: flex;
    justify-content: center;
    position: relative;
    overflow: hidden;
    font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
  }

  #shopify-section-{{ section.id }} .hero-right-image {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: calc(50vw - 120px); /* Tucked safely under the blue slant */
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .hero-right-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
  }

  #shopify-section-{{ section.id }} .hero {
    width: 100%;
    max-width: 1440px;
    height: 480px;
    position: relative;
    display: flex;
    z-index: 1;
  }

  /* LEFT SIDE */
  #shopify-section-{{ section.id }} .hero .left {
    width: 55%;
    height: 100%;
    position: relative;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .hero .left::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    left: -50vw;
    background: {{ section.settings.bg_color }};
    transform: skewX(-12deg);
    transform-origin: top right;
    border-right: 16px solid #ffffff;
    box-shadow: 8px 0 0 0 #ffd200;
    z-index: 1;
  }

  /* Decorative shapes */
  #shopify-section-{{ section.id }} .hero-shapes {
    position: absolute;
    top: 0;
    left: 35px;
    height: 100%;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .hero-shapes .shape-big {
    position: absolute;
    left: -35px;
    top: 20px;
    width: 95px;
    height: 160px;
    border-radius: 70px;
    background: linear-gradient(180deg, #fff000 0%, #d9d9d9 100%);
    transform: rotate(24deg);
  }

  #shopify-section-{{ section.id }} .hero-shapes .shape-small {
    position: absolute;
    left: 158px;
    top: 66px;
    width: 42px;
    height: 108px;
    border-radius: 30px;
    background: linear-gradient(180deg, #fff000 0%, #d8d8d8 100%);
    transform: rotate(28deg);
  }

  #shopify-section-{{ section.id }} .hero-shapes .curve {
    position: absolute;
    left: 64px;
    top: 65px;
    width: 145px;
    height: 105px;
    border: 2px solid #ffd600;
    border-color: #ffd600 transparent transparent transparent;
    border-radius: 50%;
    transform: rotate(26deg);
  }

  #shopify-section-{{ section.id }} .hero .content {
    position: absolute;
    left: 0;
    right: 0;
    margin: 0 auto;
    width: 100%;
    max-width: 1440px;
    padding: 0 20px;
    bottom: 70px;
    color: {{ section.settings.text_color }};
    z-index: 3;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .hero .content > * {
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .hero .badge {
    display: inline-block;
    padding: 7px 14px;
    background: {{ section.settings.badge_bg_color }};
    border-radius: 4px;
    margin-bottom: 38px;
    font-size: {{ section.settings.badge_font_size_desktop }}px;
    letter-spacing: 6px;
    font-weight: 500;
    border: none;
    color: {{ section.settings.badge_text_color }};
  }

  #shopify-section-{{ section.id }} .hero .content h1 {
    font-family: {{ section.settings.title_font.family }}, {{ section.settings.title_font.fallback_families }};
    font-size: {{ section.settings.title_font_size_desktop }}px;
    line-height: 1;
    font-weight: {{ section.settings.title_font.weight | default: 300 }};
    margin-bottom: 16px;
    color: {{ section.settings.title_color }};
  }

  #shopify-section-{{ section.id }} .hero .content p {
    font-size: {{ section.settings.subtitle_font_size_desktop }}px;
    line-height: 1.3;
    max-width: 520px;
    opacity: .95;
    font-weight: 300;
    color: {{ section.settings.subtitle_color }};
  }

  /* RIGHT SIDE */
  #shopify-section-{{ section.id }} .hero .right {
    width: 45%;
    height: 100%;
    position: absolute;
    right: 0;
    top: 0;
    z-index: 0;
    /* Hide the image here since it's moved to .hero-right-image */
    display: none;
  }

  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .hero-wrapper {
      flex-direction: column;
    }

    #shopify-section-{{ section.id }} .hero-shapes {
      display: none;
    }

    #shopify-section-{{ section.id }} .hero {
      flex-direction: column;
      height: auto;
      order: 1;
    }

    #shopify-section-{{ section.id }} .hero-right-image {
      position: relative;
      width: 100%;
      height: 320px;
      left: 0;
      order: 2;
    }

    #shopify-section-{{ section.id }} .hero .left,
    #shopify-section-{{ section.id }} .hero .right {
      width: 100%;
    }

    #shopify-section-{{ section.id }} .hero .left::before {
      transform: none;
      border-right: none;
      border-bottom: 8px solid #ffffff;
      box-shadow: 0 4px 0 0 #ffd200;
      left: -50vw;
      right: -50vw;
    }

    #shopify-section-{{ section.id }} .hero .content {
      position: relative;
      left: 0;
      bottom: 0;
      padding: 60px 20px 40px;
    }

    #shopify-section-{{ section.id }} .hero .content h1 {
      font-size: {{ section.settings.title_font_size_mobile }}px;
      margin-bottom: 12px;
    }

    #shopify-section-{{ section.id }} .hero .content p {
      font-size: {{ section.settings.subtitle_font_size_mobile }}px;
    }

    #shopify-section-{{ section.id }} .hero .badge {
      margin-bottom: 24px;
      font-size: {{ section.settings.badge_font_size_mobile }}px;
    }
  }
{%- endstyle -%}

<section class="hero-wrapper" id="Hero-{{ section.id }}">
  <div class="hero-right-image">
    {%- if section.settings.bg_image != blank -%}
      {{ section.settings.bg_image | image_url: width: 2000 | image_tag: loading: 'lazy', alt: section.settings.title }}
    {%- else -%}
      <img src="https://lock-cotton-75222594.figma.site/_components/v2/de14127a5882bf86a0327109f7ecf495ed27b9a8/d61cf57be2b393fdc2adcad834bc68753f4773c1.d61cf57b.png" alt="Maximm Cables">
    {%- endif -%}
  </div>
  
  <div class="hero-shapes">
    <div class="shape-big"></div>
    <div class="curve"></div>
    <div class="shape-small"></div>
  </div>
  <div class="hero">
    <div class="left">
      <div class="content">
        {%- if section.settings.badge_text != blank -%}
          <div class="badge">{{ section.settings.badge_text | escape }}</div>
        {%- endif -%}
        
        {%- if section.settings.title != blank -%}
          <h1>{{ section.settings.title | escape }}</h1>
        {%- endif -%}
        
        {%- if section.settings.subtitle != blank -%}
          <p>{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </div>
    </div>
    <div class="right">
      <!-- Image moved to .hero-right-image -->
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Media Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Maximm in Media"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Innovation in Motion"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Revolutionizing electrical space management. Watch our latest features and product showcases."
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "header",
      "content": "Color Customizations"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1818c8"
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "Badge Base Color",
      "default": "#2d41ff"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Font Customizations"
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Title Font",
      "default": "barlow_n5"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body Font",
      "default": "barlow_n4"
    },
    {
      "type": "header",
      "content": "Desktop Font Sizes"
    },
    {
      "type": "range",
      "id": "badge_font_size_desktop",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Badge Font Size",
      "default": 12
    },
    {
      "type": "range",
      "id": "title_font_size_desktop",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Title Font Size",
      "default": 64
    },
    {
      "type": "range",
      "id": "subtitle_font_size_desktop",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Font Size",
      "default": 17
    },
    {
      "type": "header",
      "content": "Mobile Font Sizes"
    },
    {
      "type": "range",
      "id": "badge_font_size_mobile",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Badge Font Size",
      "default": 12
    },
    {
      "type": "range",
      "id": "title_font_size_mobile",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Title Font Size",
      "default": 40
    },
    {
      "type": "range",
      "id": "subtitle_font_size_mobile",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Subtitle Font Size",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Media Hero"
    }
  ]
}
{% endschema %}
