{%- style -%}
#relatedProducts{
  background:{{ section.settings.bg_color }};
  padding-top:{{ section.settings.padding_top }}px;
  padding-bottom:{{ section.settings.padding_bottom }}px;
}

#relatedProducts .section-heading{
  text-align:center;
  margin-bottom:40px;
}

#relatedProducts .rp-wrapper{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:20px;
}

#relatedProducts .rp-item{
  background:#FEFEFE;
  border:1px solid #FAFAF9;
  border-radius:10px;
  padding:15px;
  text-align:center;
}

#relatedProducts .rp-item img{
  width:100%;
  aspect-ratio:1/1;
  object-fit:contain;
  display:block;
}

#relatedProducts .rp-title{
  margin:15px 0 10px;
  font-size:18px;
  line-height:1.4;
}

#relatedProducts .rp-title a{
  color:inherit;
  text-decoration:none;
}

#relatedProducts .bs-price{
  margin-top:12px;
}

#relatedProducts .bs-compare{
  text-decoration:line-through;
  color:#888;
  margin-right:8px;
}

#relatedProducts .bs-sale{
  color:#d60000;
  font-weight:700;
}

@media(max-width:991px){
  #relatedProducts .rp-wrapper{
    grid-template-columns:repeat(2,1fr);
    gap:16px;
  }
}

@media(max-width:749px){
  #relatedProducts{
    padding-top:{{ section.settings.padding_top_mobile }}px;
    padding-bottom:{{ section.settings.padding_bottom_mobile }}px;
  }

  #relatedProducts .rp-wrapper{
    grid-template-columns:repeat(2,1fr);
    gap:12px;
  }

  #relatedProducts .rp-title{
    font-size:15px;
  }
}
{%- endstyle -%}

<div id="relatedProducts">
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <h2 class="section-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% assign current_collection = product.collections.first %}

    {% if current_collection != blank %}

      <div class="rp-wrapper">

        {% assign shown = 0 %}

        {% for product_item in current_collection.products %}

          {% if product_item.id != product.id %}

            <div class="rp-item">

              <a href="{{ product_item.url }}">
                {% if product_item.featured_image %}
                  <img
                    src="{{ product_item.featured_image | image_url: width:600 }}"
                    alt="{{ product_item.title }}"
                    loading="lazy">
                {% endif %}
              </a>

              <h3 class="rp-title">
                <a href="{{ product_item.url }}">
                  {{ product_item.title }}
                </a>
              </h3>

              <div
                style="{{ jm_style }}"
                class="jdgm-widget jdgm-preview-badge"
                data-id="{{ product_item.id }}"
                data-auto-install="false">
                {{ product_item.metafields.judgeme.badge }}
              </div>

              <div class="bs-price">
                {% if product_item.compare_at_price > product_item.price %}
                  <span class="bs-compare">
                    {{ product_item.compare_at_price | money }}
                  </span>

                  <span class="bs-sale">
                    {{ product_item.price | money }}
                  </span>
                {% else %}
                  <span>
                    From {{ product_item.price | money }}
                  </span>
                {% endif %}
              </div>

            </div>

            {% assign shown = shown | plus:1 %}

            {% if shown == 4 %}
              {% break %}
            {% endif %}

          {% endif %}

        {% endfor %}

      </div>

    {% else %}

      <p>No related products found.</p>

    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Related Products new",
  "tag": "section",
  "class": "section-related-products",
  "templates": ["product"],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Related Products"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Desktop Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "header",
      "content": "Mobile Padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Related Products new"
    }
  ]
}
{% endschema %}