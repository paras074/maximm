        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Sec: Cable Products",
  "settings": [
    {
      "type": "richtext",
      "id": "section_heading__content",
      "label": "Section Heading: Content"
    },
    {
      "type": "text",
      "id": "section_heading_btn__txt",
      "label": "Section Heading Button: Text"
    },
    {
      "type": "url",
      "id": "section_heading_btn__url",
      "label": "Section Heading Button: URL"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding Bottom",
      "default": 36
    }
  ]
}
{% endschema %}
