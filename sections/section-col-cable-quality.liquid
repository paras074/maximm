{{ 'section-cable-quality.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding-mobile {
      padding-top: {{ section.settings.padding_top_mobile | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom_mobile | divided_by: 10 }}rem;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 10 }}rem;
    }
  }
{%- endstyle -%}
<div class="section-cable-quality section-{{ section.id }}-padding  section-{{ section.id }}-padding-mobile">
  <div class="page-width">
    <div class="inner-page-width">
      <div class="content-holder">
        <div class="floating-shape-1">
          <img class="w-100" src="{{ 'maximm-logo-single-element-gradient-header.svg' | asset_url }}">
        </div>        
        <div class="card_main">
          <div class="card">
            {{ section.settings.content }}
          </div>
          <div class="product-bottom">
            <a href="{{ section.settings.btn_url }}" class="heading">
              {{ section.settings.btn_txt }}
            </a>
            <a href="" class="icon-trigger">
              {%- render 'icon-arrow-right-long' -%}
            </a>
          </div>
        </div>
      </div>      
      <div class="main-image">
        {{ section.settings.main_image | image_url: width: 1000 | image_tag }}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Sec: Cable Quality",
  "settings": [
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "btn_txt",
      "label": "Button: Text"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button: URL"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding Bottom",
      "default": 0
    }
  ]
}
{% endschema %}
