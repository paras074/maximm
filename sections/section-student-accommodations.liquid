{{ 'section-student-accommodations.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding-mobile {
      padding-top: {{ section.settings.padding_top_mobile | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom_mobile | divided_by: 10 }}rem;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 10 }}rem;
    }
  }
{%- endstyle -%}
<div
  class="student-accommodations section-{{ section.id }}-padding  section-{{ section.id }}-padding-mobile"
  id="student-accommodations"
>
  <div
    class="bgImg d-none d-md-block js-parallax-image"
    style="background-image:url({{ section.settings.main_bg_image_desktop | image_url: width: 2000 }})"
  ></div>
  <div
    class="bgImg d-md-none js-parallax-image"
    style="background-image:url({{ section.settings.main_bg_image_mobile | image_url: width: 2000 }})"
  ></div>
  <div class="page-width">
    <div class="st-row st-justify-content-end">
      <div class="st-col-md-6 content-holder">
        <div class="box">
          <h2>{{ section.settings.title }}</h2>
          <div class="description gutters-end-0">
            <p>
              {{ section.settings.description }}
            </p>
            <a class="btn btn-white" href="{{ section.settings.btn_url }}">
              {{ section.settings.btn_txt }}
              <span class="ico-holder">
                <img src="{{ 'maximm-logo-single-element-gradient.svg' | asset_url }}">
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Sec: Student Accom",
  "settings": [
    {
      "type": "image_picker",
      "id": "main_bg_image_desktop",
      "label": "Desktop: Main Background Image"
    },
    {
      "type": "image_picker",
      "id": "main_bg_image_mobile",
      "label": "Mobile: Main Background Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "inline_richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "btn_txt",
      "label": "Button: Text"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button: URL"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 110
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 110
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding Bottom",
      "default": 0
    }
  ]
}
{% endschema %}
