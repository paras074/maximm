{{ 'section-latest-solutions.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding-mobile {
      padding-top: {{ section.settings.padding_top_mobile | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom_mobile | divided_by: 10 }}rem;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 10 }}rem;
    }
  }
{%- endstyle -%}
<div class="latest-solutions section-{{ section.id }}-padding  section-{{ section.id }}-padding-mobile">
  <div class="page-width js-has-stretch">
    <div class="st-row no-gutters">
      <div class="st-col-md-6 image-holder">
        <div class="js-stretch-left js-stretch-right h-100">
          {{ section.settings.image_left | image_url: width: 1000 | image_tag: loading: 'lazy' }}
        </div>
      </div>
      <div class="st-col-md-6 content-holder">
        <div>
          <div class="objects-img clearfix">
            {{
              section.settings.image_right
              | image_url: width: 1000
              | image_tag: loading: 'lazy'
            }}
          </div>
          <h2>
            {{ section.settings.title }}
          </h2>
        </div>
        <div class="content-holder__footer mt-auto">
          <div class="st-row st-align-items-center">
            <div class="st-col elems-left">
              <div class="label">
                <a href="{{ section.settings.btn_url }}">
                  <u>
                    {{ section.settings.btn_txt }}
                  </u>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Section: Latest Solutions",
  "settings": [
    {
      "type": "header",
      "content": "Header: Left"
    },
    {
      "type": "image_picker",
      "id": "image_left",
      "label": "Image: Left"
    },
    {
      "type": "header",
      "content": "Header: Right"
    },
    {
      "type": "image_picker",
      "id": "image_right",
      "label": "Image: Right"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "btn_txt",
      "label": "Button: Text"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button: URL"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding Bottom",
      "default": 0
    }
  ]
}
{% endschema %}
