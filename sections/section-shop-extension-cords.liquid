{{ 'section-shop-extension-cords.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding-mobile {
      padding-top: {{ section.settings.padding_top_mobile | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom_mobile | divided_by: 10 }}rem;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 10 }}rem;
    }
  }
{%- endstyle -%}
<div class="brand-shop-extension-cords section-{{ section.id }}-padding  section-{{ section.id }}-padding-mobile">
  <div class="page-width">
    <div class="inner-page-width">
      <div class="st-row">
        <div class="st-col-md-5 column-left">
          <div class="box ">
            <div class="image-holder d-md-none">
              {{ section.settings.main_image | image_url: width: 1000 | image_tag: class: 'w-100' }}
            </div>
            <div class="content-holder gutters-end-0">
              {{ section.settings.content }}
            </div>
          </div>
          <div class="cat-title-with-trigger-btn">
            <div class="st-row no-gutters">
              <div class="st-col">
                <h5 class="product-cat-title">
                  <a href="{{ section.settings.btn_url }}">
                    {{ section.settings.btn_txt }}
                  </a>
                </h5>
              </div>
              <div class="st-col-auto">
                <div class="product-cat-trigger-btn-wrapper">
                  <a class="product-cat-trigger-btn" href="{{ section.settings.btn_url }}">
                    {%- render 'icon-arrow-right-long' -%}
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="st-col-md column-right d-none d-md-block">
          <div class="image-holder">
            {{ section.settings.main_image | image_url: width: 1000 | image_tag: class: 'w-100' }}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Section: Extension Cords",
  "settings": [
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image"
    },
    {
      "type": "text",
      "id": "btn_txt",
      "label": "Button: Text"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button: URL"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 92
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 62
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding top",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding Bottom",
      "default": 100
    }
  ]
}
{% endschema %}
