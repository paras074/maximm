{% style %}
  #shopify-section-{{ section.id }} .wholesale-steps {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .wholesale-steps {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
{% endstyle %}

<section class="wholesale-steps" style="background-color: {{ section.settings.bg_color }};">
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <h2 class="wholesale-steps__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="wholesale-steps__row">
      {% assign total_blocks = section.blocks.size %}
      {% for block in section.blocks %}
        {% if block.type == 'step' %}
          <div class="wholesale-step" {{ block.shopify_attributes }}>
            <div class="wholesale-step__top">
              <div class="wholesale-step__badge {% if block.settings.is_complete %}wholesale-step__badge--complete{% endif %}">
                {% if block.settings.is_complete %}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                {% else %}
                  {{ forloop.index }}
                {% endif %}
              </div>
            </div>
            <div class="wholesale-step__icon">
              {% case block.settings.icon %}
                {% when 'account' %}
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                {% when 'business' %}
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"></path><path d="M5 21V7l7-4 7 4v14"></path><path d="M9 21v-6h6v6"></path><path d="M9 9h.01M9 13h.01M15 9h.01M15 13h.01"></path></svg>
                {% when 'application' %}
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2h6a1 1 0 0 1 1 1v2H8V3a1 1 0 0 1 1-1z"></path><path d="M8 4H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-3"></path><path d="m9 14 2 2 4-4"></path></svg>
                {% when 'review' %}
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 6-10 7L2 6"></path></svg>
                {% when 'check' %}
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                {% when 'cart' %}
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
              {% endcase %}
            </div>
            <h3 class="wholesale-step__title">{{ block.settings.title }}</h3>
            <p class="wholesale-step__text">{{ block.settings.text }}</p>
          </div>
          {% if forloop.index < total_blocks %}
            <div class="wholesale-step__arrow">
              <svg width="28" height="12" viewBox="0 0 28 12" fill="none"><path d="M1 6h24m0 0-5-5m5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </div>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "How Registration Works",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How Registration Works"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing - Desktop"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top (desktop)",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (desktop)",
      "default": 48
    },
    {
      "type": "header",
      "content": "Spacing - Mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "account", "label": "Person / Account" },
            { "value": "business", "label": "Building / Business" },
            { "value": "application", "label": "Clipboard / Application" },
            { "value": "review", "label": "Envelope / Review" },
            { "value": "check", "label": "Checkmark circle" },
            { "value": "cart", "label": "Cart" }
          ],
          "default": "account"
        },
        {
          "type": "checkbox",
          "id": "is_complete",
          "label": "Show green checkmark badge instead of step number",
          "default": false
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Create Account"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Enter your email and create a password."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "How Registration Works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "icon": "account",
            "is_complete": false,
            "title": "Create Account",
            "text": "Enter your email and create a password."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "business",
            "is_complete": false,
            "title": "Tell Us About Your Business",
            "text": "Provide basic business information and industry."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "application",
            "is_complete": false,
            "title": "Submit Application",
            "text": "Upload tax exempt certificate (if applicable) and submit."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "review",
            "is_complete": false,
            "title": "We Review Your Application",
            "text": "Our team will review and approve your account."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "cart",
            "is_complete": true,
            "title": "Start Saving",
            "text": "Log in and start shopping with your wholesale pricing and benefits."
          }
        }
      ]
    }
  ]
}
{% endschema %}