{{ 'section-newsletter.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding-mobile {
      padding-top: {{ section.settings.padding_top_mobile | divided_by: 10 }}rem;
      padding-bottom: 12rem;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 10 }}rem;
    }
  }
{%- endstyle -%}
<div class="top-rated-products section-{{ section.id }}-padding  section-{{ section.id }}-padding-mobile">
  <div class="page-width">
    <div class="st-row st-align-items-md-end">
      <div class="st-col-md column-left gutters-end-0">
        <div class="subtitle-filled">{{ section.settings.subtext }}</div>
        <h2>{{ section.settings.title }}</h2>
      </div>
      {% if section.settings.show_form %}
      <div class="st-col-md-6 column-right">
        <div class="apply-quote-form">
          <div {{ block.shopify_attributes }}>
            {% form 'customer', class: 'newsletter-form' %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="newsletter-form__field-wrapper">
                <div class="field">
                  <input
                    id="NewsletterForm--{{ section.id }}"
                    type="email"
                    name="contact[email]"
                    class="field__input"
                    value="{{ form.email }}"
                    aria-required="true"
                    autocorrect="off"
                    autocapitalize="off"
                    autocomplete="email"
                    {% if form.errors %}
                      autofocus
                      aria-invalid="true"
                      aria-describedby="Newsletter-error--{{ section.id }}"
                    {% elsif form.posted_successfully? %}
                      aria-describedby="Newsletter-success--{{ section.id }}"
                    {% endif %}
                    placeholder="Email"
                    required
                  >
                  {% comment %} <label class="field__label" for="NewsletterForm--{{ section.id }}">
                    {{ 'newsletter.label' | t }}
                  </label> {% endcomment %}
                  <button
                    type="submit"
                    class="newsletter-form__button field__button"
                    name="commit"
                    id="Subscribe"
                    aria-label="{{ 'newsletter.button_label' | t }}"
                  >
                   Sign up 
                   <span class="ico-holder">
                    <img src="{{ 'maximm-logo-single-element-gradient.svg' | asset_url }}">
                   </span>
                  </button>
                </div>
                {%- if form.errors -%}
                  <small class="newsletter-form__message form__message" id="Newsletter-error--{{ section.id }}">
                    {%- render 'icon-error' -%}
                    {{- form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email -}}
                  </small>
                {%- endif -%}
              </div>
              {%- if form.posted_successfully? -%}
                <h3
                  class="newsletter-form__message newsletter-form__message--success form__message"
                  id="Newsletter-success--{{ section.id }}"
                  tabindex="-1"
                  autofocus
                >
                  {% render 'icon-success' -%}
                  {{- 'newsletter.success' | t }}
                </h3>
              {%- endif -%}
            {% endform %}
          </div>
        </div>
      </div>
      {% endif %}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Section: Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "subtext",
      "label": "Sub Title",
      "default": "TOP RATED PRODUCTS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Extension Cords, Internet Cables, Hdmi, & More Buy In Bulk Wholesale Pricing."
    },
    {
      "type": "checkbox",
      "id": "show_form",
      "label": "Show Form?",
      "default":  true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding Bottom",
      "default": 66
    }
  ],
  "presets": [
    {
      "name": "Section: Newsletter"
    }
  ]
}
{% endschema %}
