{{ 'section-secondary-banner.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding-mobile {
      padding-top: {{ section.settings.padding_top_mobile | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom_mobile | divided_by: 10 }}rem;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 10 }}rem;
    }
  }
{%- endstyle -%}
<div class="secondary-banner secondary-banner--maximm-360 section-{{ section.id }}-padding  section-{{ section.id }}-padding-mobile">
  <div
    class="bgImg"
    style="background-image:url({{ section.settings.main_banner_bg_image | image_url: width: 2000 }})"
  ></div>
  <div class="page-width">
    <div class="inner-page-width gutters-end-0 ">
      <div class="content-holder">
        {{ section.settings.content }}
      </div>
    </div>
  </div>
  <div class="floating-cable">
    {{ section.settings.bottom_floating_image | image_url: width: 800 | image_tag: class: 'w-100 parallaxBlockUp' }}    
  </div>
</div>

{% schema %}
{
  "name": "Banner: Maximm-360",
  "settings": [
    {
      "type": "image_picker",
      "id": "main_banner_bg_image",
      "label": "background: Main Image"
    },
    {
      "type": "image_picker",
      "id": "bottom_floating_image",
      "label": "Bottom Floating Image"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding Bottom",
      "default": 50
    }
  ]
}
{% endschema %}
