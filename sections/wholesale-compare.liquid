{% style %}
  #shopify-section-{{ section.id }} .wholesale-compare {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .wholesale-compare {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
{% endstyle %}

<section class="wholesale-compare" style="background-color: {{ section.settings.bg_color }};">
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <h2 class="wholesale-compare__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="wholesale-compare__table">

      <div class="wholesale-compare__row wholesale-compare__row--head">
        <div class="wholesale-compare__cell wholesale-compare__cell--label">
          {{ section.settings.features_label }}
        </div>
        <div class="wholesale-compare__cell wholesale-compare__cell--guest">
          <span class="wholesale-compare__col-title">{{ section.settings.guest_label }}</span>
          {% if section.settings.guest_sublabel != blank %}
            <span class="wholesale-compare__col-sub">{{ section.settings.guest_sublabel }}</span>
          {% endif %}
        </div>
        <div class="wholesale-compare__cell wholesale-compare__cell--wholesale">
          <span class="wholesale-compare__col-title">{{ section.settings.wholesale_label }}</span>
          {% if section.settings.wholesale_sublabel != blank %}
            <span class="wholesale-compare__col-sub">{{ section.settings.wholesale_sublabel }}</span>
          {% endif %}
        </div>
      </div>

      {% for block in section.blocks %}
        {% if block.type == 'row' %}
          <div class="wholesale-compare__row" {{ block.shopify_attributes }}>
            <div class="wholesale-compare__cell wholesale-compare__cell--label">
              <span class="wholesale-compare__icon">
                {% case block.settings.icon %}
                  {% when 'pricing' %}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41 11 3.83A2 2 0 0 0 9.59 3.24L3 3v6.59a2 2 0 0 0 .59 1.41l9.58 9.58a2 2 0 0 0 2.82 0l4.6-4.6a2 2 0 0 0 0-2.83Z"></path><circle cx="7.5" cy="7.5" r="1.5"></circle></svg>
                  {% when 'history' %}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11H3v10h6V11z"></path><path d="M21 3h-6v18h6V3z"></path><path d="M15 7H9v14h6V7z"></path></svg>
                  {% when 'reorder' %}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                  {% when 'location' %}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                  {% when 'star' %}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                  {% when 'tax' %}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                  {% when 'support' %}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"></path><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path></svg>
                {% endcase %}
              </span>
              <span>{{ block.settings.label }}</span>
            </div>
            <div class="wholesale-compare__cell wholesale-compare__cell--guest">
              {{ block.settings.guest_value }}
            </div>
            <div class="wholesale-compare__cell wholesale-compare__cell--wholesale">
              <span class="wholesale-compare__check">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </span>
              {{ block.settings.wholesale_value }}
            </div>
          </div>
        {% endif %}
      {% endfor %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Guest vs Wholesale Table",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Compare: Guest Shopping vs. Wholesale Account"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing - Desktop"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top (desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (desktop)",
      "default": 60
    },
    {
      "type": "header",
      "content": "Spacing - Mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 32
    },
    {
      "type": "header",
      "content": "Column labels"
    },
    {
      "type": "text",
      "id": "features_label",
      "label": "Features column label",
      "default": "FEATURES"
    },
    {
      "type": "text",
      "id": "guest_label",
      "label": "Guest column label",
      "default": "GUEST SHOPPER"
    },
    {
      "type": "text",
      "id": "guest_sublabel",
      "label": "Guest column sublabel",
      "default": "(No Account)"
    },
    {
      "type": "text",
      "id": "wholesale_label",
      "label": "Wholesale column label",
      "default": "WHOLESALE ACCOUNT"
    },
    {
      "type": "text",
      "id": "wholesale_sublabel",
      "label": "Wholesale column sublabel",
      "default": "(Registered & Approved)"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "pricing", "label": "Tag / Pricing" },
            { "value": "history", "label": "Clipboard / History" },
            { "value": "reorder", "label": "Cart / Reorder" },
            { "value": "location", "label": "Location" },
            { "value": "star", "label": "Star" },
            { "value": "tax", "label": "Document / Tax" },
            { "value": "support", "label": "Support" }
          ],
          "default": "pricing"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Row label",
          "default": "Pricing"
        },
        {
          "type": "text",
          "id": "guest_value",
          "label": "Guest shopper value",
          "default": "Standard pricing"
        },
        {
          "type": "text",
          "id": "wholesale_value",
          "label": "Wholesale account value",
          "default": "Exclusive wholesale pricing"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Guest vs Wholesale Table",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "icon": "pricing",
            "label": "Pricing",
            "guest_value": "Standard pricing",
            "wholesale_value": "Exclusive wholesale pricing"
          }
        },
        {
          "type": "row",
          "settings": {
            "icon": "history",
            "label": "Order History & Invoices",
            "guest_value": "Not available",
            "wholesale_value": "Full access to order history & invoices"
          }
        },
        {
          "type": "row",
          "settings": {
            "icon": "reorder",
            "label": "Quick Reorder",
            "guest_value": "Not available",
            "wholesale_value": "Reorder in one click"
          }
        },
        {
          "type": "row",
          "settings": {
            "icon": "location",
            "label": "Multiple Shipping Addresses",
            "guest_value": "Single shipping address only",
            "wholesale_value": "Ship to multiple addresses"
          }
        },
        {
          "type": "row",
          "settings": {
            "icon": "star",
            "label": "Saved Carts & Lists",
            "guest_value": "Not available",
            "wholesale_value": "Save carts & lists for later"
          }
        },
        {
          "type": "row",
          "settings": {
            "icon": "tax",
            "label": "Tax Exempt",
            "guest_value": "Pay taxes at checkout",
            "wholesale_value": "Upload certificate & shop tax exempt"
          }
        },
        {
          "type": "row",
          "settings": {
            "icon": "support",
            "label": "Priority Support",
            "guest_value": "Standard support",
            "wholesale_value": "Priority support from our wholesale team"
          }
        }
      ]
    }
  ]
}
{% endschema %}