<div
  class="login-b2b"
  style="
    --login-b2b-bg: {{ section.settings.bg_color | default: '#f4f4f4' }};
    --login-b2b-pt-desktop: {{ section.settings.padding_top }}px;
    --login-b2b-pb-desktop: {{ section.settings.padding_bottom }}px;
    --login-b2b-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --login-b2b-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="login-b2b__container page-width">

    <div class="login-b2b__image">
      {% if section.settings.image %}
        <img
          srcset="
            {{ section.settings.image | image_url: width: 400 }} 400w,
            {{ section.settings.image | image_url: width: 800 }} 800w,
            {{ section.settings.image | image_url: width: 1200 }} 1200w
          "
          src="{{ section.settings.image | image_url: width: 800 }}"
          alt="{{ section.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
        >
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'login-b2b__placeholder-svg' }}
      {% endif %}
    </div>

    <div class="login-b2b__content">
        {% if section.settings.welcome != blank %}
            <h1 class="login-welcome">{{ section.settings.welcome }}</h1>
        {% endif %}

        {% if section.settings.welsub_heading != blank %}
            <p class="login-b2b__sub-heading">{{ section.settings.welsub_heading }}</p>
        {% endif %}

        <form method="post" class="login-b2b-form" action="/account/login" id="customer_login" accept-charset="UTF-8" novalidate="novalidate"><input type="hidden" name="form_type" value="customer_login">

            <input type="hidden" name="utf8" value="✓">
            <div class="Form__Item">
                
                <input
                        id="CustomerEmail"
                        type="email"
                        name="customer[email]"
                        class="Form__Input input"
                        aria-required="true"
                        autocorrect="off"
                        autocapitalize="off"
                        autocomplete="email"
                        {% if form.errors %}
                            autofocus
                            aria-invalid="true"
                        {% elsif form.posted_successfully? %}
                            aria-describedby="ContactFooter-success"
                        {% endif %}
                        placeholder="Enter your email"
                        required
                >
                
            </div>

            <div class="Form__Item">
                
                <input
                        id="CustomerPassword"
                        type="password"
                        name="customer[password]"
                        class="Form__Input input"
                        aria-required="true"
                        autocorrect="off"
                        autocapitalize="off"
                        autocomplete="email"
                        {% if form.errors %}
                            autofocus
                            aria-invalid="true"
                        {% elsif form.posted_successfully? %}
                            aria-describedby="ContactFooter-success"
                        {% endif %}
                        placeholder="Enter your password"
                        required
                >
                
                <div class="Form__ItemHelp Link Link--primary">
                    <a href="/account/login#recover">
                        Forgot password?
                    </a>
                </div>
            </div>



            <button class="btn btn-warning">
                Sign In
            </button>

        </form>
      {% if section.settings.heading != blank %}
        <h3 class="login-b2b__heading">{{ section.settings.heading }}</h3>
      {% endif %}

      {% if section.settings.sub_heading != blank %}
        <p class="login-b2b__sub-heading">{{ section.settings.sub_heading }}</p>
      {% endif %}


      
      {% if section.settings.button_label != blank %}
        <a
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
          class="login-b2b__button button"
        >
          {{ section.settings.button_label }}
        </a>
      {% endif %}

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Login B2B",
  "tag": "section",
  "class": "section-login-b2b",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (left side)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F4F4F4"
    },
     {
      "type": "header",
      "content": "Wel Come Content"
    },
    {
      "type": "text",
      "id": "welcome",
      "label": "Heading",
      "default": "Welcome to Maximm Business"
    },
    {
      "type": "textarea",
      "id": "welsub_heading",
      "label": "Wel come Sub heading",
      "default": "Sign in to access your account and place orders"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Open an account"
    },
    {
      "type": "textarea",
      "id": "sub_heading",
      "label": "Sub heading",
      "default": "Get access to wholesale discounts, product announcements and more when you qualify for a Business-to-Business account"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Apply For An Account"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Desktop padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    },
    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Login b2b"
    }
  ]
}
{% endschema %}