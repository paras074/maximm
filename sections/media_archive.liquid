{%- style -%}
  {{ section.settings.title_font | font_face: font_display: 'swap' }}
  {{ section.settings.body_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} .archive {
    --primary: {{ section.settings.primary_color }};
    --text-dark: {{ section.settings.text_color }};
    --text-gray: {{ section.settings.text_gray }};
    --bg-light: {{ section.settings.bg_color }};
    
    --badge-color: {{ section.settings.badge_text_color }};
    --section-title-color: {{ section.settings.section_title_color }};
    --card-title-color: {{ section.settings.card_title_color }};
    --card-desc-color: {{ section.settings.card_desc_color }};
    --meta-color: {{ section.settings.meta_color }};
    --link-color: {{ section.settings.link_color }};

    background-color: var(--bg-light);
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
    color: var(--text-dark);
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .archive {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} .container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 20px;
  }

  #shopify-section-{{ section.id }} .badge {
    display: inline-block;
    background-color: var(--primary);
    color: var(--badge-color);
    font-size: {{ section.settings.badge_font_size_desktop }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 5px;
    padding: 4px 14px;
    border-radius: 4px;
    margin-bottom: 16px;
  }

  #shopify-section-{{ section.id }} .section-title {
    font-family: {{ section.settings.title_font.family }}, {{ section.settings.title_font.fallback_families }};
    font-size: {{ section.settings.section_title_font_size_desktop }}px;
    font-weight: {{ section.settings.title_font.weight | default: 500 }};
    color: var(--section-title-color);
    margin-bottom: 40px;
    margin-top: 0;
  }

  #shopify-section-{{ section.id }} .archive-grid {
    display: grid;
    grid-template-columns: 1fr;
    row-gap: 40px;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .archive-grid {
      grid-template-columns: 1fr 1fr;
      column-gap: 60px;
      row-gap: 80px;
    }
  }

  #shopify-section-{{ section.id }} .archive-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .archive-title {
    font-family: {{ section.settings.title_font.family }}, {{ section.settings.title_font.fallback_families }};
    font-size: {{ section.settings.card_title_font_size_desktop }}px;
    font-weight: 600;
    color: var(--card-title-color);
    line-height: 1.3;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .archive-desc {
    font-size: {{ section.settings.card_desc_font_size_desktop }}px;
    color: var(--card-desc-color);
    margin: 0;
  }

  #shopify-section-{{ section.id }} .archive-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
  }
  
  #shopify-section-{{ section.id }} .date-meta {
    font-size: {{ section.settings.meta_font_size_desktop }}px;
    font-weight: 500;
    color: var(--meta-color);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  

  #shopify-section-{{ section.id }} a {
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .text-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--link-color);
    font-size: {{ section.settings.link_font_size_desktop }}px;
    font-weight: 500;
  }
  
  #shopify-section-{{ section.id }} .text-link svg {
    width: 10px;
    height: 10px;
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .badge {
      font-size: {{ section.settings.badge_font_size_mobile }}px;
    }
    #shopify-section-{{ section.id }} .section-title {
      font-size: {{ section.settings.section_title_font_size_mobile }}px;
    }
    #shopify-section-{{ section.id }} .archive-title {
      font-size: {{ section.settings.card_title_font_size_mobile }}px;
    }
    #shopify-section-{{ section.id }} .archive-desc {
      font-size: {{ section.settings.card_desc_font_size_mobile }}px;
    }
    #shopify-section-{{ section.id }} .date-meta {
      font-size: {{ section.settings.meta_font_size_mobile }}px;
    }
    #shopify-section-{{ section.id }} .text-link {
      font-size: {{ section.settings.link_font_size_mobile }}px;
    }
  }
{%- endstyle -%}

<section class="archive" id="Archive-{{ section.id }}">
  <div class="container">
    {%- if section.settings.badge_text != blank -%}
      <div class="badge">{{ section.settings.badge_text | escape }}</div>
    {%- endif -%}
    
    {%- if section.settings.section_title != blank -%}
      <h2 class="section-title">{{ section.settings.section_title | escape }}</h2>
    {%- endif -%}
    
    <div class="archive-grid">
      {%- if section.settings.data_source == 'blog' and section.settings.blog != blank -%}
        {%- for article in section.settings.blog.articles limit: section.settings.max_items -%}
          <div class="archive-card">
            <h3 class="archive-title">{{ article.title | escape }}</h3>
            <p class="archive-desc">{{ article.excerpt_or_content | strip_html | truncatewords: 25 }}</p>
            <div class="archive-meta">
              <span class="date-meta">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                {{ article.published_at | date: "%b %Y" }}
              </span>
              <a href="{{ article.url }}" class="text-link">
                Read More
                <svg viewBox="0 0 11 11" fill="none"><path d="M1 10L10 1M10 1H3M10 1V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <div class="archive-card" {{ block.shopify_attributes }}>
            <h3 class="archive-title">{{ block.settings.title | escape }}</h3>
            <p class="archive-desc">{{ block.settings.description | escape }}</p>
            <div class="archive-meta">
              <span class="date-meta">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                {{ block.settings.date | escape }}
              </span>
              {%- if block.settings.link_text != blank -%}
                <a href="{{ block.settings.link }}" class="text-link">
                  {{ block.settings.link_text | escape }}
                  <svg viewBox="0 0 11 11" fill="none"><path d="M1 10L10 1M10 1H3M10 1V8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
