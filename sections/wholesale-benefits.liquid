      "label": "Section background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing - Desktop"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top (desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (desktop)",
      "default": 60
    },
    {
      "type": "header",
      "content": "Spacing - Mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 32
    },
    {
      "type": "header",
      "content": "Shop as Guest"
    },
    {
      "type": "text",
      "id": "guest_heading",
      "label": "Heading",
      "default": "Shop as Guest"
    },
    {
      "type": "text",
      "id": "guest_item_1",
      "label": "List item 1",
      "default": "Browse all products"
    },
    {
      "type": "text",
      "id": "guest_item_2",
      "label": "List item 2",
      "default": "See standard pricing"
    },
    {
      "type": "text",
      "id": "guest_item_3",
      "label": "List item 3",
      "default": "Checkout quickly"
    },
    {
      "type": "text",
      "id": "guest_button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "guest_button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "guest_note",
      "label": "Note text",
      "default": "No account required"
    },
    {
      "type": "header",
      "content": "Wholesale Benefits (center)"
    },
    {
      "type": "text",
      "id": "benefits_heading",
      "label": "Heading",
      "default": "Register for a Wholesale Account and Unlock Exclusive Benefits"
    },
    {
      "type": "header",
      "content": "Ready to Get Started"
    },
    {
      "type": "text",
      "id": "ready_heading",
      "label": "Heading",
      "default": "Ready to Get Started?"
    },
    {
      "type": "textarea",
      "id": "ready_text",
      "label": "Text",
      "default": "Create your wholesale account in just a few minutes."
    },
    {
      "type": "text",
      "id": "ready_button_label",
      "label": "Button label",
      "default": "Create Wholesale Account"
    },
    {
      "type": "url",
      "id": "ready_button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "ready_note",
      "label": "Note text",
      "default": "Your information is secure"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
