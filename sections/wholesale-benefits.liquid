
{% style %}
  #shopify-section-{{ section.id }} .wholesale-section {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .wholesale-section {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
{% endstyle %}

<section class="wholesale-section" style="background-color: {{ section.settings.bg_color }};">
  <div class="page-width">
    <div class="head-content">
        {% if section.settings.heading != blank %}
          <h2 class="wholesale-section__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="wholesale-section__subheading">{{ section.settings.subheading }}</p>
        {% endif %}
    </div>
    <div class="wholesale-grid">

      <!-- LEFT: Shop as Guest -->
      <div class="wholesale-card wholesale-card--guest">
        <div class="wholesale-card__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
        </div>
        <h3>{{ section.settings.guest_heading }}</h3>
        <ul class="wholesale-card__list">
          {% for i in (1..3) %}
            {% assign key = 'guest_item_' | append: i %}
            {% if section.settings[key] != blank %}
              <li>{{ section.settings[key] }}</li>
            {% endif %}
          {% endfor %}
        </ul>
        <a href="{{ section.settings.guest_button_link }}" class="wholesale-btn wholesale-btn--primary">
          {{ section.settings.guest_button_label }}
        </a>
        {% if section.settings.guest_note != blank %}
          <p class="wholesale-card__note">{{ section.settings.guest_note }}</p>
        {% endif %}
      </div>

      <!-- CENTER: Wholesale Benefits -->
      <div class="wholesale-card wholesale-card--benefits">
        <h3 class="wholesale-card--benefits__heading">{{ section.settings.benefits_heading }}</h3>
        <div class="wholesale-benefits">
          {% for block in section.blocks %}
            {% if block.type == 'benefit' %}
              <div class="wholesale-benefit" {{ block.shopify_attributes }}>
                <div class="wholesale-benefit__icon">
                  {% case block.settings.icon %}
                    {% when 'pricing' %}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41 11 3.83A2 2 0 0 0 9.59 3.24L3 3v6.59a2 2 0 0 0 .59 1.41l9.58 9.58a2 2 0 0 0 2.82 0l4.6-4.6a2 2 0 0 0 0-2.83Z"></path><circle cx="7.5" cy="7.5" r="1.5"></circle></svg>
                    {% when 'reorder' %}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                    {% when 'history' %}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11H3v10h6V11z"></path><path d="M21 3h-6v18h6V3z"></path><path d="M15 7H9v14h6V7z"></path></svg>
                    {% when 'tax' %}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                    {% when 'star' %}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                    {% when 'support' %}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"></path><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path></svg>
                    {% when 'location' %}
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                  {% endcase %}
                </div>
                <h4 class="wholesale-benefit__title">{{ block.settings.title }}</h4>
                <p class="wholesale-benefit__text">{{ block.settings.text }}</p>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <!-- RIGHT: Ready to Get Started -->
      <div class="wholesale-card wholesale-card--ready">
        <div class="wholesale-card__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        </div>
        <h3>{{ section.settings.ready_heading }}</h3>
        <p>{{ section.settings.ready_text }}</p>
        <a href="{{ section.settings.ready_button_link }}" class="wholesale-btn wholesale-btn--primary">
          {{ section.settings.ready_button_label }}
        </a>
        {% if section.settings.ready_note != blank %}
          <p class="wholesale-card__note">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            {{ section.settings.ready_note }}
          </p>
        {% endif %}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wholesale Benefits",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Register for a Wholesale Account?"
