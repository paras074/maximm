{% style %}
  #shopify-section-{{ section.id }} .solution-wrapper {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    position: relative;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .solution-bg-svg {
    position: absolute;
    top: 0;
    right: 0;
    width: 182px;
    height: 171px;
    pointer-events: none;
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .solution-bg-svg svg {
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .solution-title {
    font-size: {{ section.settings.title_size_mobile }}px;
    font-weight: 500;
    color: {{ section.settings.title_color }};
    margin-bottom: 24px;
    font-family: 'Barlow', sans-serif;
  }

  #shopify-section-{{ section.id }} .solution-text {
    font-size: {{ section.settings.text_size_mobile }}px;
    color: {{ section.settings.text_color }};
    max-width: 1200px;
    margin-bottom: 60px;
    font-family: 'Barlow', sans-serif;
  }

  #shopify-section-{{ section.id }} .solution-text p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .products-header {
    font-size: {{ section.settings.products_header_size_mobile }}px;
    font-weight: 500;
    color: {{ section.settings.products_header_color }};
    margin-bottom: 30px;
    font-family: 'Barlow', sans-serif;
  }

  #shopify-section-{{ section.id }} .products-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  #shopify-section-{{ section.id }} .product-card {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  #shopify-section-{{ section.id }} .product-img-box {
    background: {{ section.settings.product_img_bg }};
    height: 296px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 50px;
  }

  #shopify-section-{{ section.id }} .product-img-box img {
    width: 100%;
    height: auto;
    max-height: 100%;
    mix-blend-mode: multiply;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} .product-info h4 {
    font-size: 21px;
    font-weight: 600;
    margin-bottom: 8px;
    color: #000;
    font-family: 'Barlow', sans-serif;
  }

  #shopify-section-{{ section.id }} .product-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: {{ section.settings.product_link_color }};
    font-weight: 500;
    font-size: 14px;
    text-decoration: none;
    font-family: 'Barlow', sans-serif;
  }

  #shopify-section-{{ section.id }} .product-link:hover {
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .solution-wrapper {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    #shopify-section-{{ section.id }} .solution-title {
      font-size: {{ section.settings.title_size_desktop }}px;
    }
    #shopify-section-{{ section.id }} .solution-text {
      font-size: {{ section.settings.text_size_desktop }}px;
      margin-bottom: 80px;
    }
    #shopify-section-{{ section.id }} .products-header {
      font-size: {{ section.settings.products_header_size_desktop }}px;
      margin-bottom: 40px;
    }
    #shopify-section-{{ section.id }} .products-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
{% endstyle %}

<div class="solution-wrapper">

  {% if section.settings.show_bg_graphic %}
  <div class="solution-bg-svg">
    <svg class="absolute block inset-0 size-full" fill="none" preserveAspectRatio="none" viewBox="0 0 182 171" xmlns="http://www.w3.org/2000/svg">
      <rect width="36.3534" height="77.7107" rx="18.1767" transform="matrix(-0.906308 0.422618 0.422618 0.906308 32.9474 2.87549)" fill="url(#paint0_linear_{{ section.id }})"/>
      <rect width="70.4487" height="155.827" rx="35.2244" transform="matrix(-0.906308 0.422618 0.422618 0.906308 170.166 0)" fill="url(#paint1_linear_{{ section.id }})"/>
      <path d="M42.8773 26.3596C53.2363 44.1328 83.6214 83.5337 112.238 104.729C138.811 124.411 151.722 131.687 155.025 133.715" stroke="url(#paint2_linear_{{ section.id }})" stroke-width="1.56162"/>
      <defs>
        <linearGradient id="paint0_linear_{{ section.id }}" x1="26.7867" y1="4.05633" x2="10.0488" y2="75.0458" gradientUnits="userSpaceOnUse">
          <stop offset="0.104167" stop-color="#F1DE2C"/>
          <stop offset="1" stop-color="white" stop-opacity="0.28"/>
        </linearGradient>
        <linearGradient id="paint1_linear_{{ section.id }}" x1="51.9096" y1="8.13381" x2="17.3092" y2="149.955" gradientUnits="userSpaceOnUse">
          <stop offset="0.104167" stop-color="#F1DE2C"/>
          <stop offset="1" stop-color="white" stop-opacity="0.28"/>
        </linearGradient>
        <linearGradient id="paint2_linear_{{ section.id }}" x1="85.6646" y1="44.2521" x2="95.8287" y2="136.504" gradientUnits="userSpaceOnUse">
          <stop stop-color="#F1DE2C"/>
          <stop offset="1" stop-color="#1A1DC9"/>
        </linearGradient>
      </defs>
    </svg>
  </div>
  {% endif %}

  <div class="container page-width">
    {% if section.settings.title != blank %}
      <h2 class="solution-title">{{ section.settings.title }}</h2>
    {% endif %}
    
    {% if section.settings.text != blank %}
      <div class="solution-text">
        {{ section.settings.text }}
      </div>
    {% endif %}

    {% if section.settings.products_header != blank %}
      <h3 class="products-header">{{ section.settings.products_header }}</h3>
    {% endif %}

    <div class="products-grid">
      {% for block in section.blocks %}
        {% assign prod = block.settings.product %}
        {% assign card_title = block.settings.custom_title | default: prod.title %}
        {% assign card_url = block.settings.custom_url | default: prod.url %}
        {% assign card_image = block.settings.custom_image | default: prod.featured_image %}
        
        <div class="product-card" {{ block.shopify_attributes }}>
          <div class="product-img-box">
            {% if card_image != blank %}
              <img src="{{ card_image | img_url: '600x' }}" alt="{{ card_title | escape }}">
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
          <div class="product-info">
            {% if card_title != blank %}
              <h4>{{ card_title }}</h4>
            {% else %}
              <h4>Product Title</h4>
            {% endif %}
            
            <a href="{{ card_url | default: '#' }}" class="product-link">
              <u>Browse Product</u>
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                <path d="M1 9L9 1M9 1H2.5M9 1V7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Case Study Solution",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_bg_graphic",
      "label": "Show Background Graphic (Top Right)",
      "default": true
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "The Maximm Solution: Precision Engineering"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Section Text",
      "default": "<p>We orchestrated a multi-site deployment across three continents, moving from the initial blueprint to a fully functional backbone. By focusing on Architectural Integrity, we optimized the physical layout to enhance both airflow and electrical efficiency.</p>"
    },
    {
      "type": "text",
      "id": "products_header",
      "label": "Products Header",
      "default": "Products Served"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f9f9fa"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#1a1dc9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "products_header_color",
      "label": "Products Header Color",
      "default": "#2b2f42"
    },
    {
      "type": "color",
      "id": "product_img_bg",
      "label": "Product Image Background",
      "default": "#f2f2f2"
    },
    {
      "type": "color",
      "id": "product_link_color",
      "label": "Product Link Color",
      "default": "#273CFF"
    },
    {
      "type": "header",
      "content": "Typography (Desktop)"
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Title Size",
      "default": 48
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "min": 14,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 24
    },
    {
      "type": "range",
      "id": "products_header_size_desktop",
      "min": 20,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Products Header Size",
      "default": 32
    },
    {
      "type": "header",
      "content": "Typography (Mobile)"
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Title Size",
      "default": 32
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Text Size",
      "default": 18
    },
    {
      "type": "range",
      "id": "products_header_size_mobile",
      "min": 18,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Products Header Size",
      "default": 24
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Top (Desktop)",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom (Desktop)",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom (Mobile)",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product",
          "info": "Leave blank to use custom data below"
        },
        {
          "type": "header",
          "content": "Custom Override Data",
          "info": "These fields will override the selected product's data, or act as standalone fields if no product is selected."
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Title"
        },
        {
          "type": "url",
          "id": "custom_url",
          "label": "Custom URL"
