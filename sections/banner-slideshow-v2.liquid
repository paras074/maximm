{{ 'banner-slideshow-v2.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding-mobile {
      padding-top: {{ section.settings.padding_top_mobile | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom_mobile | divided_by: 10 }}rem;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 10 }}rem;
    }
  }
{%- endstyle -%}
{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}
<div class="hero-banner hero-banner-v2 section-{{ section.id }}-padding  section-{{ section.id }}-padding-mobile">
  <div class="swiper js-banner-image-slider-v2">
    <div class="swiper-wrapper">
      {% for slide in section.blocks %}
      <div class="swiper-slide {% if slide.settings.hide_gradient == true %} hide-gradient{% endif %}">
          <div class="page-width">
  <div
    class="content-holder h-100 d-flex flex-column justify-content-end"
    style="
      background-image: url('{% if request.device_type == 'mobile' and slide.settings.image_mobile != blank %}{{ slide.settings.image_mobile | image_url: width: 700 }}{% else %}{{ slide.settings.image_desktop | image_url: width: 2200 }}{% endif %}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    "
  >
    <div class="content">

      <div class="content-text{% if slide.settings.content_width == 'medium' %} half-width{% elsif slide.settings.content_width == 'large' %} full-width{% endif %}">
        <div class="subtitle">{{ slide.settings.subtitle }}</div>
        <h1 class="title">{{ slide.settings.title }}</h1>

        {% if slide.settings.desc != blank %}
          <div class="description">
            {{ slide.settings.desc }}
          </div>
        {% endif %}
      </div>

      {% if slide.settings.foot_note != blank %}
        <div class="foot-note">
          {{ slide.settings.foot_note }}
        </div>
      {% endif %}

      {% if forloop.length > 1 %}
        <div class="button-with-nav">
          <div class="button-group">
            {% if slide.settings.btn_text != blank %}
              <a class="btn btn-white" href="{{ slide.settings.btn_url }}">
                {{ slide.settings.btn_text }}
                <span class="ico-holder">
                  <img src="{{ 'maximm-logo-single-element-gradient.svg' | asset_url }}" alt="banner-icon">
                </span>
              </a>
            {% endif %}

            {% if slide.settings.btn_2_text != blank %}
              <a class="btn btn-yellow" href="{{ slide.settings.btn_2_url }}">
                {{ slide.settings.btn_2_text }}
                <span class="ico-holder">
                  <img src="{{ 'maximm-logo-element- yellow.svg' | asset_url }}" alt="banner-icon">
                </span>
              </a>
            {% endif %}
          </div>

          <div class="swiper-buttons">
            <div class="swiper-button-prev"></div>
            <div class="swiper-button-next"></div>
          </div>
        </div>
      {% endif %}

    </div>
  </div>
</div>
        <div class="page-width">
          <div class="content-holder h-100 d-flex flex-column justify-content-end">
            <div class="content">
              
              <div class="content-text{% if slide.settings.content_width == 'medium' %} half-width{% elsif slide.settings.content_width == 'large' %} full-width{% endif %}">
                <div class="subtitle">{{ slide.settings.subtitle }}</div>
                <h1 class="title">
                  {{ slide.settings.title }}
                </h1>
                {%- if slide.settings.desc != blank%}
                  <div class="description">
                    {{ slide.settings.desc }}
                  </div>
                {%- endif -%}
              </div>
              {% if slide.settings.foot_note != blank %}  
              <div class="foot-note">
                {{ slide.settings.foot_note }}
              </div>
              {% endif %}
              {% if forloop.length > 1 %}
              <div class="button-with-nav">
                <div class="button-group">
                  {%- if slide.settings.btn_text != blank -%}
                    <a class="btn btn-white" href="{{ slide.settings.btn_url }}"
                    >{{ slide.settings.btn_text }}
                      <span class="ico-holder">
                        <img src="{{ 'maximm-logo-single-element-gradient.svg' | asset_url }}" alt="banner-icon">
                      </span>
                    </a>
                  {%- endif -%}
                  {%- if slide.settings.btn_2_text != blank -%}
                    <a class="btn btn-yellow" href="{{ slide.settings.btn_2_url }}"
                    >{{ slide.settings.btn_2_text }}
                      <span class="ico-holder">
                        <img src="{{ 'maximm-logo-element- yellow.svg' | asset_url }}" alt="banner-icon">
                      </span>
                    </a>
                  {%- endif -%}                  
                </div>
                
                <div class="swiper-buttons">
                  <div class="swiper-button-prev"></div>
                  <div class="swiper-button-next"></div>
                </div>
              </div>
              {% endif %}
            </div>
          </div>
        </div>
        <div class="parallaxBlockUp hero-banner-v2-floater">
          <svg width="299" height="245" viewBox="0 0 299 245" fill="none">
            <rect x="251.798" y="4.11963" width="52.0812" height="111.331" rx="26.0406" transform="rotate(25 251.798 4.11963)" fill="url(#paint0_linear_280_7643)"/>
            <rect x="55.3467" y="-0.000244141" width="100.927" height="223.243" rx="50.4637" transform="rotate(25 55.3467 -0.000244141)" fill="url(#paint1_linear_280_7643)"/>
            <path d="M237.705 37.7639C222.864 63.2265 179.334 119.674 138.337 150.039C100.267 178.235 81.7699 188.66 77.0381 191.565" stroke="url(#paint2_linear_280_7643)" stroke-width="1.56162"/>
            <defs>
            <linearGradient id="paint0_linear_280_7643" x1="290.174" y1="9.93088" x2="266.194" y2="111.633" gradientUnits="userSpaceOnUse">
            <stop offset="0.104167" stop-color="#F1DE2C"/>
            <stop offset="1" stop-color="white" stop-opacity="0.28"/>
            </linearGradient>
            <linearGradient id="paint1_linear_280_7643" x1="129.714" y1="11.6526" x2="80.1444" y2="214.831" gradientUnits="userSpaceOnUse">
            <stop offset="0.104167" stop-color="#F1DE2C"/>
            <stop offset="1" stop-color="white" stop-opacity="0.28"/>
            </linearGradient>
            <linearGradient id="paint2_linear_280_7643" x1="176.406" y1="63.3974" x2="161.845" y2="195.56" gradientUnits="userSpaceOnUse">
            <stop stop-color="#F1DE2C"/>
            <stop offset="1" stop-color="#1A1DC9"/>
            </linearGradient>
            </defs>
          </svg>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  
</div>

{% schema %}
{
  "name": "Banner: Slideshow v2",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Image (Desktop)"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Image (Mobile)"
        },
        {
          "type": "select",
          "id": "content_width",
          "label": "Content Width",
          "options": [
            {
              "value": "small",
              "label": "Small"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "large",
              "label": "Large"
            }
          ],
          "default": "small"
        },
        {
          "type":"checkbox",
          "id": "hide_gradient",
          "label": "Hide Blue Gradient",
          "default": false

        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "inline_richtext",
          "id": "desc",
          "label": "Description"
        },        
        {
          "type": "richtext",
          "id": "foot_note",
          "label": "Foot Note"
        },                         
        {
          "type": "text",
          "id": "btn_text",
          "label": "Button Text"
        },
        {
          "type": "url",
          "id": "btn_url",
          "label": "Button URL"
        },                        
        {
          "type": "text",
          "id": "btn_2_text",
          "label": "Button 2: Text"
        },
        {
          "type": "url",
          "id": "btn_2_url",
          "label": "Button 2: URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banner: Slideshow v2"
    }
  ]
}
{% endschema %}
