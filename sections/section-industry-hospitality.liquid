{{ 'section-industry-hospitality.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding-mobile {
      padding-top: {{ section.settings.padding_top_mobile | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom_mobile | divided_by: 10 }}rem;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 10 }}rem;
    }
  }
{%- endstyle -%}
<div
  class="industry-hospitality section-{{ section.id }}-padding  section-{{ section.id }}-padding-mobile"
  id="industry-hopitality">
  <div class="bgImg" style="background-image:url({{ 'grid-bg.svg' | asset_url }})"></div>
  <div class="logo-element">
    <img class="w-100 parallaxBlockUp" src="{{ 'maximm-logo-element-yellow-gradient.svg' | asset_url }}">
  </div>
  <div class="page-width">
    <div class="inner-page-width">
      <div class="st-row st-align-items-center">
        <div class="st-col-md image-holder">
          {{ section.settings.main_image | image_url: width: 1000 | image_tag: class: 'w-100' }}
        </div>
        <div class="st-col-md-6 content-holder">
          {{ section.settings.content }}
          <a class="btn btn-dark" href="{{ section.settings.btn_url }}">
            {{ section.settings.btn_txt }}
            <span class="ico-holder">
              <img src="{{ 'maximm-logo-single-element-gradient.svg' | asset_url }}">
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Sec: Service",
  "settings": [
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "btn_txt",
      "label": "Button: Text"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button: URL"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 140
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding top",
      "default": 66
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding Bottom",
      "default": 126
    }
  ]
}
{% endschema %}
