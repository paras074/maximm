{{ 'section-convenience-home.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding-mobile {
      padding-top: {{ section.settings.padding_top_mobile | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom_mobile | divided_by: 10 }}rem;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 10 }}rem;
    }
  }
{%- endstyle -%}
<div class="convenience-home section-{{ section.id }}-padding  section-{{ section.id }}-padding-mobile">
  <div class="floating-elem">
    <img class="w-100 parallaxBlockUp" src="{{ 'convenience-home-floating-elem.png' | asset_url }}">
  </div>
  <div class="page-width js-has-stretch">
    <div class="section-heading d-md-none ">
      <div class="subtitle-filled">{{ section.settings.subtxt }}</div>
      <h3 class="font-weight-normal">
        {{ section.settings.sectionHeadingTitle }}
      </h3>
      <div class="small">{{ section.settings.sectionHeadingShortText }}</div>
    </div>
    <div class="st-row st-align-items-center gutters-80">
      <div class="st-col-md-4 column-left">
        <div class="js-stretch-left">
          <div class="swiper js-convenience-home-image-slider">
            <div class="swiper-wrapper">
              {% for block in section.blocks %}
              <div class="swiper-slide">
                {% if block.settings.image != blank %}
                  {{ block.settings.image |  image_url: width: 800 |  image_tag: class:'w-100' }}
                {% endif %}
              </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
      <div class="st-col-md-8 column-right">
        <div class="section-heading d-none d-md-block">
          <div class="subtitle-filled">{{ section.settings.subtxt }}</div>
          <h3 class="font-weight-normal">
            {{ section.settings.sectionHeadingTitle }}
          </h3>
          <div class="small">{{ section.settings.sectionHeadingShortText }}</div>
        </div>
        <div class="swiper js-convenience-home-content-slider">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
            <div class="swiper-slide">
              <div class="st-row st-align-items-md-center">
                <div class="st-col">
                  <div class="content-holder gutters-end-0">
                    <h4 class="title">{{ block.settings.title }}</h4>
                    {{ block.settings.content }}
                  </div>
                </div>
                <div class="st-col-auto swiper-slide-count">0{{ forloop.index }}</div>
              </div>
            </div>
            {% endfor %}
          </div>
          <div class="swiper-buttons">
            <div class="swiper-button-prev"></div>
            <div class="swiper-button-next"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Sec: Convenience Home",
  "settings": [
    {
      "type": "text",
      "id": "subtxt",
      "label": "Section Heading: Sub Text"
    },
    {
      "type": "inline_richtext",
      "id": "sectionHeadingTitle",
      "label": "Section Heading: Title"
    },
    {
      "type": "inline_richtext",
      "id": "sectionHeadingShortText",
      "label": "Section Heading: Bottom Short Text"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "name": "Image with Text Slide",
      "type":"image-txt-slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    }
  ]
}
{% endschema %}
