{%- style -%}
  #findRightCord {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
   #findRightCord .frc-left {
    flex: 0 0 280px;
    background-color: {{ section.settings.left_bg_color }};
    padding: 15px;
    display: flex;
    /* flex-direction: column; */
    gap: 5px;
    border-right: 1px solid #FEFEFE;
  }
  #findRightCord .frc-btn {
    display: inline-block;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    padding: 10px 20px;
    border-radius: 4px;
    text-decoration: none;
    text-align: center;
    width: fit-content;
  }
  @media screen and (max-width: 749px) {
    #findRightCord {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
{%- endstyle -%}

<div id="findRightCord">
  <div class="page-width">

    {%- if section.settings.heading != blank -%}
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="frc-outer">

      <div class="frc-left">
        {%- if section.settings.left_icon != blank -%}
          <div class="frc-left-icon">
            <img src="{{ section.settings.left_icon | image_url: width: 100 }}" alt="{{ section.settings.left_heading }}" loading="lazy">
          </div>
        {%- endif -%}
        <div class="frc-left-text">
            {%- if section.settings.left_heading != blank -%}
                <h3>{{ section.settings.left_heading }}</h3>
            {%- endif -%}

            {%- if section.settings.left_description != blank -%}
                <p class="frc-left-desc">{{ section.settings.left_description }}</p>
            {%- endif -%}

            {%- if section.settings.button_label != blank -%}
                <a href="{{ section.settings.button_link | default: '#' }}" class="frc-btn">{{ section.settings.button_label }}</a>
            {%- endif -%}
        </div>
      </div>

      <div class="frc-right">
        {%- if section.settings.right_heading != blank -%}
          <h3>{{ section.settings.right_heading }}</h3>
        {%- endif -%}

        <div class="frc-items">
          {%- for block in section.blocks -%}
            <a href="{{ block.settings.link | default: '#' }}" class="frc-item" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <img src="{{ block.settings.icon | image_url: width: 100 }}" alt="{{ block.settings.label }}" loading="lazy">
              {%- endif -%}
              {%- if block.settings.label != blank -%}
                <span>{{ block.settings.label }}</span>
              {%- endif -%}
            </a>
          {%- endfor -%}
        </div>

        {%- if section.settings.viewall_label != blank -%}
          <a href="{{ section.settings.viewall_link | default: '#' }}" class="frc-viewall">
            {{ section.settings.viewall_label }}
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M5 12H19M19 12L13 6M19 12L13 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif -%}
      </div>

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Find the Right Cord",
  "tag": "section",
  "class": "section-find-right-cord",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading (optional, top of section)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Left Panel"
    },
    {
      "type": "color",
      "id": "left_bg_color",
      "label": "Left panel background color",
      "default": "#f2f2f2"
    },
    {
      "type": "image_picker",
      "id": "left_icon",
      "label": "Icon"
    },
    {
      "type": "text",
      "id": "left_heading",
      "label": "Heading",
      "default": "Find the Right Cord"
    },
    {
      "type": "textarea",
      "id": "left_description",
      "label": "Description",
      "default": "Answer a few simple questions and we'll recommend the perfect product for you."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get Started"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background color",
      "default": "#1a7a3c"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Right Panel"
    },
    {
      "type": "text",
      "id": "right_heading",
      "label": "Heading",
      "default": "What are you plugging in?"
    },
    {
      "type": "text",
      "id": "viewall_label",
      "label": "View all label",
      "default": "View All Options"
    },
    {
      "type": "url",
      "id": "viewall_link",
      "label": "View all link"
    },
    {
      "type": "header",
      "content": "Desktop Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    },
    {
      "type": "header",
      "content": "Mobile Padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Plug-in Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Item"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Find the Right Cord",
      "blocks": [
        { "type": "item", "settings": { "label": "TV" } },
        { "type": "item", "settings": { "label": "Computer" } },
        { "type": "item", "settings": { "label": "Air Conditioner" } },
        { "type": "item", "settings": { "label": "Lamp" } },
        { "type": "item", "settings": { "label": "Holiday Lights" } },
        { "type": "item", "settings": { "label": "Network" } },
        { "type": "item", "settings": { "label": "Gaming" } },
        { "type": "item", "settings": { "label": "Office" } },
        { "type": "item", "settings": { "label": "Contractor Installation" } }
      ]
    }
  ]
}
{% endschema %}