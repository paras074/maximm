{% stylesheet %}
    .table-of-content {
        padding: 36px 0 0;
        /* background-color: rgba(244, 246, 254, 0.8); */
        margin-top: 50px!important;
    }
    .table-of-content h3{
        display: inline-flex;
        background-color: #273CFF;
        color: #FFF;
        padding: 0.8rem 0.4rem 0.8rem 0.9rem;
        border-radius: 0.4rem;
        font-size: 1.2rem;
        font-weight: 600;
        letter-spacing: 0.5rem;
        line-height: 1.4285;
    }
    .table-of-content li{
        list-style-type: decimal;
        padding-left: 1rem;
        margin-bottom: 1rem;
    }
    .table-of-content li::marker{
        color: #0D112C;
        font-size: 1.6rem;
        font-weight: 500;
    }
    .table-of-content li a{
        color: #0D112C;
        font-size: 1.61rem;
        font-weight: 500;
        text-decoration: underline;
        transition: color   0.3s ease;
    }
    .table-of-content li:hover a{
        color: #273CFF;
    }

    
{% endstylesheet %}

