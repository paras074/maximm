<script>
  // Container selector
  const tabContainer = document.querySelector('.industries-types');

  if (tabContainer) {
    const tabButtons = tabContainer.querySelectorAll('.tab-btn');
    const tabItems = tabContainer.querySelectorAll('.tab-item');

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetTab = btn.getAttribute('data-tab');

        // Remove active class from buttons
        tabButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        // Remove active/show classes from tab items
        tabItems.forEach((tab) => {
          tab.classList.remove('active', 'show');
        });

        // Add active to target tab
        const target = tabContainer.querySelector('#' + targetTab);
        target.classList.add('active');

        // small timeout for smooth fade
        setTimeout(() => {
          target.classList.add('show');
        }, 10);
      });
    });
  }
</script>

{% schema %}
{
    "name" : "B2B Industries",
    "class": "section b2b-industries-section",
    "settings": [
        {
            "type": "richtext",
            "id": "title",
            "label": "Title"
        },
        {
            "type": "inline_richtext",
            "id": "featured_section_title",
            "label": "Features Section Title"
        },
        {
            "type": "inline_richtext",
            "id": "featured_section_btn_title",
            "label": "Features Section Button Title"
        },        
        {
            "type": "url",
            "id": "featured_section_btn_link",
            "label": "Features Section Button link"
        }     
    ],
    "blocks": [
        {
            "type": "cards",
            "name": "Features Card",
            "settings":[
                {
                    "type": "text",
                    "id": "cards_title",
                    "label": "Features Title",
                    "default": "Title"
                    
                },
                {
                    "type": "richtext",
                    "id": "cards_info",
                    "label": "Features Info"
                },
                {                  
                    "type": "image_picker",
                    "id": "card_icon",
                    "label": "Card Icon"        
                }
            ]
        }
    ],
    
    "presets": [
        {
        "name": "B2B Industries"
        }
    ]
}

{% endschema %}