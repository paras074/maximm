{{ 'section-best-selling-products.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{% if collection.metafields.custom.best_selling_products != blank %}
{%- style -%}
  .section-{{ section.id }}-padding-mobile {
      padding-top: {{ section.settings.padding_top_mobile | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom_mobile | divided_by: 10 }}rem;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 10 }}rem;
    }
  }
{%- endstyle -%}
<div class="best-selling-products section-{{ section.id }}-padding  section-{{ section.id }}-padding-mobile">
  <div class="page-width">
    <div class="section-heading ">
      {{ section.settings.section_heading }}
    </div>
    <div class="swiper js-best-products-slider">
      <div class="swiper-wrapper">
        {% for product in  collection.metafields.custom.best_selling_products.value %}
        <div class="swiper-slide">
          {% render 'card-product-col', product: product %}
        </div>
        {% endfor %}
      </div>
    </div>
    <div class="btn-wrapper">
      <a class="btn btn-primary" href="{{ section.settings.btm_btn_url }}" target="_blank">
        {{ section.settings.btm_btn_txt }}
        <span class="ico-holder">
          <img src="{{ 'maximm-logo-single-element-gradient.svg' | asset_url }}">
        </span>
      </a>
    </div>
  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "Sec: Best Selling Prods",
  "settings": [
    {
      "type": "richtext",
      "id": "section_heading",
      "label": "Section Heading"
    },
    {
      "type": "text",
      "id": "btm_btn_txt",
      "label": "Bottom Button: Text"
    },
    {
      "type": "url",
      "id": "btm_btn_url",
      "label": "Bottom Button: URL"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding Bottom",
      "default": 0
    }
  ]
}
{% endschema %}
