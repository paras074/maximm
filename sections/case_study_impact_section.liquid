{% style %}
  #shopify-section-{{ section.id }} .impact-section {
    background: {{ section.settings.bg_gradient }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: calc({{ section.settings.padding_bottom_mobile }}px + {{ section.settings.bottom_image_margin_mobile | abs }}px);
    color: #fff;
    font-family: 'Barlow', sans-serif;
  }

  #shopify-section-{{ section.id }} .impact-header {
    text-align: center;
    margin-bottom: 40px;
  }

  #shopify-section-{{ section.id }} .impact-header h2 {
    font-size: {{ section.settings.title_size_mobile }}px;
    font-weight: 500;
    margin-bottom: 24px;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .impact-header h2 span.highlight {
    color: {{ section.settings.title_highlight_color }};
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .impact-header h2 span.light {
    font-weight: 300;
    color: {{ section.settings.title_light_color }};
  }

  #shopify-section-{{ section.id }} .impact-header .impact-subtext {
    font-size: {{ section.settings.text_size_mobile }}px;
    font-weight: 300;
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .impact-header .impact-subtext p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .impact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  #shopify-section-{{ section.id }} .impact-item {
    position: relative;
  }

  #shopify-section-{{ section.id }} .impact-title-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 12px;
  }

  #shopify-section-{{ section.id }} .slash-icon.yellow {
    display: block;
    width: 10px;
    height: 21px;
    background: linear-gradient(195deg, #416bff 16%, #fff 94%);
    border-radius: 80px;
    transform: rotate(25deg);
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .impact-title {
    font-size: {{ section.settings.item_title_size_mobile }}px;
    font-weight: 500;
    color: {{ section.settings.item_title_color }};
    margin: 0;
  }

  #shopify-section-{{ section.id }} .impact-desc {
    font-size: {{ section.settings.item_desc_size_mobile }}px;
    font-weight: 400;
    padding-left: 0;
    opacity: 0.9;
    color: {{ section.settings.item_desc_color }};
    margin: 0;
  }

  #shopify-section-{{ section.id }} .footer-image {
    width: 100%;
    position: relative;
    margin-top: {{ section.settings.bottom_image_margin_mobile }}px;
    z-index: 10;
    pointer-events: none;
    line-height: 0;
    font-size: 0;
  }

  #shopify-section-{{ section.id }} .footer-image img {
    width: 100%;
    height: auto;
    display: block;
    margin: 0;
    padding: 0;
  }

  .impact-desc{
    max-width:250px;
  }

  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .impact-section {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: calc({{ section.settings.padding_bottom }}px + {{ section.settings.bottom_image_margin | abs }}px);
    }
    #shopify-section-{{ section.id }} .impact-header {
      margin-bottom: 80px;
    }
    #shopify-section-{{ section.id }} .impact-header h2 {
      font-size: {{ section.settings.title_size_desktop }}px;
    }
    #shopify-section-{{ section.id }} .impact-header .impact-subtext {
      font-size: {{ section.settings.text_size_desktop }}px;
    }
    #shopify-section-{{ section.id }} .impact-title {
      font-size: {{ section.settings.item_title_size_desktop }}px;
    }
    #shopify-section-{{ section.id }} .impact-desc {
      font-size: {{ section.settings.item_desc_size_desktop }}px;
    }
    #shopify-section-{{ section.id }} .impact-grid {
      grid-template-columns: repeat(3, 1fr);
      row-gap: 64px;
      max-width: 1200px;
      margin: 0 auto;
    }
    #shopify-section-{{ section.id }} .impact-item:nth-child(3n+1) {
      padding-right: 20px;
    }
    #shopify-section-{{ section.id }} .impact-item:nth-child(3n+2) {
      padding: 0 20px;
    }
    #shopify-section-{{ section.id }} .impact-item:nth-child(3n+3) {
      padding-left: 20px;
    }
    #shopify-section-{{ section.id }} .impact-item:nth-child(3n+2)::before,
    #shopify-section-{{ section.id }} .impact-item:nth-child(3n+3)::before {
      content: "";
      position: absolute;
      left: -50px;
      top: 50%;
      transform: translateY(-50%);
      width: 1px;
      height: 57px;
      background-color: {{ section.settings.grid_border_color }};
    }
    #shopify-section-{{ section.id }} .footer-image {
      margin-top: {{ section.settings.bottom_image_margin }}px;
    }
  }

  @media screen and (max-width:767px){
    .impact-section .container {
    padding-left: 20px !important;
    padding-right: 20px !important;
}
.impact-desc {
    max-width: 100%;
}
  }
{% endstyle %}

<div class="impact-section">
  <div class="container" style="max-width: 100%; margin: 0 auto; padding: 0 00px;">
    <div class="impact-header">
      <h2>
        {% if section.settings.title_highlight != blank %}
          <span class="highlight">{{ section.settings.title_highlight }}</span>
        {% endif %}
        {% if section.settings.title_separator != blank %}
          {{ section.settings.title_separator }}
        {% endif %}
        {% if section.settings.title_light != blank %}
          <span class="light">{{ section.settings.title_light }}</span>
        {% endif %}
      </h2>
      {% if section.settings.subtext != blank %}
        <div class="impact-subtext">
          {{ section.settings.subtext }}
        </div>
      {% endif %}
    </div>

    <div class="impact-grid">
      {% for block in section.blocks %}
        <div class="impact-item" {{ block.shopify_attributes }}>
          <div class="impact-title-row">
            <div class="slash-icon yellow"></div>
            {% if block.settings.title != blank %}
              <h3 class="impact-title">{{ block.settings.title }}</h3>
            {% endif %}
          </div>
          {% if block.settings.description != blank %}
            <p class="impact-desc">{{ block.settings.description }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% if section.settings.show_bottom_image %}
  <div class="footer-image">
    {% if section.settings.bottom_image != blank %}
      <img src="{{ section.settings.bottom_image | img_url: 'master' }}" alt="Footer Image">
    {% elsif section.settings.bottom_image_url != blank %}
      <img src="{{ section.settings.bottom_image_url }}" alt="Footer Image">
    {% else %}
      <img src="https://lock-cotton-75222594.figma.site/_components/v2/de14127a5882bf86a0327109f7ecf495ed27b9a8/87f33e1747aeacbd2cb2653e86019093384859ce.87f33e17.png" alt="Abstract Background Wires">
    {% endif %}
  </div>
{% endif %}

