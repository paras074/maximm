{{ 'section-our-journey.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding-mobile {
      padding-top: {{ section.settings.padding_top_mobile | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom_mobile | divided_by: 10 }}rem;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 10 }}rem;
    }
  }
{%- endstyle -%}
<div class="our-journey section-{{ section.id }}-padding  section-{{ section.id }}-padding-mobile" id="our-journey">
  <div class="page-width">
    <div class="inner-page-width">
      <div class="section-heading ">
        <h2>
          {{ section.settings.title }}
        </h2>
      </div>
      <div class="st-row">
        <div class="st-col-md-4 column-left">
          <img class="logo-element w-100" src="{{ 'maximm-logo-element-yellow-gradient.svg' | asset_url }}">
        </div>
        <div class="st-col-md column-right">
          <div class="box ">
            {{ section.settings.description }}
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="bottom-full-image">
    {{
      section.settings.btm_floating_img_desktop
      | image_url: width: 2000
      | image_tag: class: 'w-100 d-none d-md-block parallaxBlockUp'
    }}
    {{
      section.settings.btm_floating_img_mobile
      | image_url: width: 600
      | image_tag: class: 'w-100 d-block d-md-none parallaxBlockUp'
    }}
  </div>
</div>
{% schema %}
{
  "name": "Section: Our Journey",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "image_picker",
      "id": "btm_floating_img_desktop",
      "label": "Desktop: Bottom Floating Image"
    },
    {
      "type": "image_picker",
      "id": "btm_floating_img_mobile",
      "label": "Mobile: Bottom Floating Image"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 130
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding Bottom",
      "default": 0
    }
  ]
}
{% endschema %}
