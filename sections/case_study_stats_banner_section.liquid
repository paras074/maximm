{% style %}
  #shopify-section-{{ section.id }} .stats-banner {
    background: {{ section.settings.bg_gradient | default: section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
    box-shadow: 1px 2px 2px rgba(0,0,0,0.25);
  }

  #shopify-section-{{ section.id }} .stats-banner-wrapper {
    text-align: center;
    color: {{ section.settings.text_color }};
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    font-size: {{ section.settings.font_size_mobile }}px;
    font-family: 'Barlow', sans-serif;
    flex-wrap: wrap; /* allow wrapping on very small screens */
  }
  #shopify-section-{{ section.id }} .stats-banner .highlight {
    color: {{ section.settings.highlight_color }};
    font-style: italic;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .stats-banner img {
    height: 48px;
    width: auto;
    border-radius: 64px;
    border: 1px solid {{ section.settings.image_border_color }};
    object-fit: cover;
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .stats-banner-wrapper {
      flex-direction: column;
      gap: 16px;
    }
  }

  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .stats-banner img {
      height: 64px;
      width: 256px;
    }
  }

  @media (min-width: 992px) {
    #shopify-section-{{ section.id }} .stats-banner {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
      margin-bottom: {{ section.settings.margin_bottom_desktop }}px;
    }
    #shopify-section-{{ section.id }} .stats-banner-wrapper {
      font-size: {{ section.settings.font_size_desktop }}px;
      flex-direction: row;
    }
  }
{% endstyle %}

<div class="stats-banner">
  <div class="page-width">
    <div class="stats-banner-wrapper">
      {% if section.settings.text_before != blank %}
        <div class="stats-text-before">
          {{ section.settings.text_before }}
        </div>
      {% endif %}

      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | img_url: '600x' }}" alt="{{ section.settings.image.alt | escape }}">
      {% else %}
        <div style="height: 64px; width: 256px; border-radius: 64px; border: 1px solid {{ section.settings.image_border_color }}; background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; color: white; font-size: 14px;">
          Placeholder Image
        </div>
      {% endif %}

      {% if section.settings.text_after != blank %}
        <div class="stats-text-after">
          {{ section.settings.text_after }}
        </div>
      {% endif %}
      </div>
    </div>
</div>

{% schema %}
{
  "name": "Case Study Stats",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "html",
      "id": "text_before",
      "label": "Text Before Image (HTML)",
      "default": "Powering <span class=\"highlight\">4,200,000+</span>",
      "info": "Use <span class=\"highlight\">...</span> to apply the highlight color."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Inline Image"
    },
    {
      "type": "html",
      "id": "text_after",
      "label": "Text After Image (HTML)",
      "default": "nodes worldwide"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "default": "linear-gradient(90deg, #06004A 0%, #1111B0 100%), #273CFF"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color Fallback",
      "default": "#06004a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight Color",
      "default": "#f1de2c"
    },
    {
      "type": "color",
      "id": "image_border_color",
      "label": "Image Border Color",
      "default": "#416bff"
    },
    {
      "type": "header",
      "content": "Typography Settings"
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Font Size (Desktop)",
      "default": 42
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 14,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Font Size (Mobile)",
      "default": 24
    },
    {
      "type": "header",
      "content": "Spacing Settings"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Top (Desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom (Desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom (Mobile)",
      "default": 24
    },
    {
      "type": "range",
      "id": "margin_bottom_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Margin Bottom (Desktop)",
      "default": 120
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Margin Bottom (Mobile)",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Case Study Stats",
      "category": "Banner"
    }
  ]
}
{% endschema %}

