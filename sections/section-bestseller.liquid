{{ 'section-baseseller.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding-mobile {
      padding-top: {{ section.settings.padding_top_mobile | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom_mobile | divided_by: 10 }}rem;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 10 }}rem;
    }
  }
{%- endstyle -%}
<div class="bestsellerofyear section-{{ section.id }}-padding  section-{{ section.id }}-padding-mobile">
  <div class="floating-shape-1 d-none d-md-block parallaxBlockUp">
    <img class="w-100" src="{{ 'about-maximm-logo-element.svg' | asset_url }}">
  </div>
  <div class="floating-tag-wrapper">
    <div class="page-width">
      <div class="inner-page-width">
        <div class="st-row no-gutters st-align-items-center">
          <div class="st-col st-col-md-6 c-col--left"></div>
          <div class="st-col-auto st-col-md c-col--right">
            <div class="floating-tag">
              <img class="w-100" src="{{ 'bestsellerTagBg.png' | asset_url }}">
              <div class="floating-tag__content">
                <div class="label">Bestseller
                  of year</div>
                <div class="label-value">
                  2026
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="page-width">
    <div class="inner-page-width">
      <div class="st-row no-gutters st-align-items-center">
        <div class="st-col-md-6 image-holder">
          {{ section.settings.video | video_tag: muted: true, autoplay: true, loop: true, controls: false }}
        </div>
        <div class="st-col-md content-holder">
          <h2>
            {{ section.settings.title }}
          </h2>
          <div>{{ section.settings.desc }}</div>
          <div class="inline-ethernet-cables-short-info st-row no-gutters">
            <div class="item st-col">
              <div class="st-row st-align-items-center">
                <div class="st-col-auto">
                  <img class="ico" src="{{ 'unique-space-saving.svg' | asset_url }}">
                </div>
                <div class="st-col label">
                  Unique<br>
                  Space-Saving
                </div>
              </div>
            </div>
            <div class="item st-col">
              <div class="st-row st-align-items-center">
                <div class="st-col-auto">
                  <img class="ico" src="{{ 'rotating-flat-plug.svg' | asset_url }}">
                </div>
                <div class="st-col label">
                  Rotating<br>
                  Flat Plug
                </div>
              </div>
            </div>
          </div>
          <div>
            {% if section.settings.btn_text != blank %}
            <a class="btn btn-white" href="{{  section.settings.btn_url }}">
              {{  section.settings.btn_text }}
              <span class="ico-holder">
                <img src="{{ 'maximm-logo-single-element-gradient.svg' | asset_url }}">
              </span>
            </a>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Section: Best Seller",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Hosted Video"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Extend All <br> Your Outlets <br> With Maximm"
    },
    {
      "type": "richtext",
      "id": "desc",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Explore Product"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 220,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 220
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 275
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 250,
      "step": 5,
      "unit": "px",
      "label": "Mobile: Padding top",
      "default": 220
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Mobile: Padding Bottom",
      "default": 120
    }
  ]
}
{% endschema %}
