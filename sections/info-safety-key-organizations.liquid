                  <ul>
                    <li><strong>S</strong> : Service Grade (rated for 600 volts) </li>
                    <li><strong>J</strong> : Junior (rated for 300 volts; common for household use) </li>
                    <li><strong>T</strong> : Thermoplastic insulation (durable and flexible material) </li>
                    <li><strong>W</strong> : Weather-Resistant / Outdoor Use </li>
                  </ul>
                  
                  </div>
                </details>
                <details
                  id="Details-cable-2"
                >
                  <summary id="Summary-cable-2">
 
                    <h3 class="accordion__title inline-richtext h4">
                      <img class="icon" src="{{ 'cable-icon.png' | asset_url }}">Other Common Letter Codes
                    </h3>
                    {% render 'icon-caret' %}
                  </summary>
                  <div
                    class="accordion__content rte"
                    id="CollapsibleAccordion-cable-2"
                    role="region"
                    aria-labelledby="Summary-cable-2"
                  >
                  <ul>
                    <li><strong>SJ</strong> : Junior Service (300V, indoor use)</li>
                    <li><strong>SJT</strong> : Junior, Thermoplastic, general indoor use</li>
                    <li><strong>SJTW</strong> : Junior, Thermoplastic, Weather-Resistant (outdoor-rated)</li>
                    <li><strong>STW</strong> : Service, Thermoplastic, Weather-Resistant (heavier-duty)</li>
                    <li><strong>SJEOOW</strong> : Junior, Thermoplastic Elastomer, Oil/Water/Weather-Resistant; remains flexible even in cold weather</li>
                  </ul>
                  </div>
                </details>
