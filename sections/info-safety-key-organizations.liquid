{{ 'info-safety.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  
{%- endstyle -%}



{%- liquid
  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign show_mobile_slider = false
  if section.settings.swipe_on_mobile and section.blocks.size > columns_mobile_int
    assign show_mobile_slider = true
  endif
-%}

<div class="info-safety-key-sections" id="key-organizations">
  <div class="floating-shape-1 d-none d-md-block parallaxBlockUp">
    <img class="w-100" src="{{ 'about-maximm-logo-element.svg' | asset_url }}">
  </div>
  <div class="page-width">
    <div class="top-section">
      <div class="st-row">
        <div class="st-col-md-6 column-left">
          <h2>Key Organizations</h2>
        </div>
        <div class="st-col-md column-right">
          <div class="description has-custom-bullet-list gutters-end-0">
            <p>
              <strong>Adopted in all 50 states,</strong> NFPA 70 – National Electrical Code (NEC) serves as the
              benchmark for
              <strong
                >safe electrical design, installation, and inspection, protecting both people and property from
                electrical hazards.</strong
              >
            </p>
            <p>
              As part of the Electrical Code Coalition, NEMA and NFPA work together to promote consistent NEC adoption
              and provide resources that <strong>support electrical safety.</strong>
            </p>
            <ul>
              <li>NATIONAL ELECTRICAL CODE (NEC)</li>
              <li>NATIONAL ELECTRICAL MANUFACTURERS ASSOCIATION (NEMA)</li>
              <li>NATIONAL FIRE PROTECTION ASSOCIATION (NFPA-70)</li>
              <li>ELECTRICAL SAFETY FOUNDATION INTERNATIONAL (ESFI)</li>
            </ul>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>
<div class="info-safety-key-sections" id="product-certification">

  <div class="page-width">

    <div class="bottom-section">
      <div class="section-heading">
        <h2>Product Certification and Testing</h2>
        <p>
          There are three globally recognized testing laboratories accredited by OSHA as Nationally Recognized Testing
          Laboratories (NRTLs). These organizations certify extension cords and related products to ensure they meet
          strict safety standards and comply with all relevant codes and regulations.
        </p>
        <p>
          When shopping for cords, plugs, or outlets, look for certification marks from these organisations to confirm
          the product meets industry safety standards.
        </p>
      </div>
      <ul class="certification-info-items">
        <li class="certification-info-item">
          <div class="logo-holder"><img src="{{ 'logo-ul.png' | asset_url }}" alt=""></div>
          UL (Underwriters Laboratories)
        </li>
        <li class="certification-info-item">
          <div class="logo-holder"><img src="{{ 'logo-etl.png' | asset_url }}" alt=""></div>
          ETL (Intertek/ETL Listed)
        </li>
        <li class="certification-info-item">
          <div class="logo-holder"><img src="{{ 'logo-csa.png' | asset_url }}" alt=""></div>
          CSA (Canadian Standards Association)
        </li>
      </ul>
    </div>
  </div>
</div>
<div class="info-safety-section" id="understanding-NEMA">
  <div class="page-width">
    <div class="section-heading">
      <h2>Understanding NEMA</h2>
      <p>
        You’ll often see <strong>“NEMA”</strong> listed on plugs or outlet specifications. <strong>NEMA</strong> stands
        for <strong>National Electrical Manufacturers Association</strong>, the body that defines standard
        configurations for plugs, outlets, and receptacles in North America. NEMA standards specify voltage, amperage,
        grounding, and plug shape — ensuring compatibility and safety across different electrical systems.
      </p>
    </div>
    <div class="cpt-box">
      <div class="subtitle-filled">common plug types</div>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <th>Type</th>
            <th>Description</th>
            <th>Typical Use</th>
            <th>Voltage / Amperag</th>
          </thead>
          <tbody>
            <tr>
              <th>NEMA 1-15</th>
              <td>2-prong, ungrounded</td>
              <td>Lamps, chargers, small appliances</td>
              <td><a class="btn btn-outline-primary" href="#">125V / 15A</a></td>
            </tr>
            <tr>
              <th>NEMA 5-15</th>
              <td>3-prong, grounded (most common household outlet)</td>
              <td>Computers, TVs, kitchen appliances</td>
              <td><a class="btn btn-outline-primary" href="#">125V / 15A</a></td>
            </tr>
            <tr>
              <th>NEMA 5-20</th>
              <td>Similar to 5-15 but with one horizontal prong</td>
              <td>Power tools, heavier appliances</td>
              <td><a class="btn btn-outline-primary" href="#">125V / 20A</a></td>
            </tr>
            <tr>
              <th>NEMA 6-15 / 6-20</th>
              <td>250V plugs for high-power devices</td>
              <td>Air conditioners, industrial tools</td>
              <td><a class="btn btn-outline-primary" href="#">250V / 15- 20A</a></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

