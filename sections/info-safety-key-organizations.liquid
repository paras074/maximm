            <div class="subtitle-filled">Our Wide Range of cables</div>
            
              <div
                class="accordion"
              >
                <details
                  id="Details-cable-1"
                    open
                >
                  <summary id="Summary-cable-1">
 
                    <h3 class="accordion__title inline-richtext h4">
