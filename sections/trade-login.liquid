{% comment %}
  Redirect logged in users back to the homepage
{% endcomment %}

{%- if customer.tags contains 'b2b' -%}
    <script>
        window.location.href = '/index#spark-account';
    </script>
{% endif %}

<div class="page-width trade-login">

    <div class="b2b-login-wrapper">

        <div class="b2b-intro-image" style="background-image: url('{{ section.settings.featured_image.src | img_url: '1000x' }}');background-color: {{ section.settings.background_color }}; background-repeat: no-repeat;">

        </div>

        <div class="b2b-login-area" style="background: {{ section.settings.background_color }};">

            <h1 class="Form__Title Heading u-h1">{{ section.settings.title }}</h1>

            <div class="intro-text">
                <p>{{ section.settings.intro_text }}</p>
            </div>

            <div class="form-vertical">

                {% comment %}
                  Login form
                {% endcomment %}

                <form method="post" action="/account/login" id="customer_login" accept-charset="UTF-8" novalidate="novalidate"><input type="hidden" name="form_type" value="customer_login">

                    <input type="hidden" name="utf8" value="✓">
                    <div class="Form__Item">
                     
                        <input
                                id="CustomerEmail"
                                type="email"
                                name="customer[email]"
                                class="Form__Input input"
                                aria-required="true"
                                autocorrect="off"
                                autocapitalize="off"
                                autocomplete="email"
                                {% if form.errors %}
                                    autofocus
                                    aria-invalid="true"
                                {% elsif form.posted_successfully? %}
                                    aria-describedby="ContactFooter-success"
                                {% endif %}
                                placeholder="Enter your email"
                                required
                        >
                        
                    </div>

                    <div class="Form__Item">
                     
                        <input
                                id="CustomerPassword"
                                type="password"
                                name="customer[password]"
                                class="Form__Input input"
                                aria-required="true"
                                autocorrect="off"
                                autocapitalize="off"
                                autocomplete="email"
                                {% if form.errors %}
                                    autofocus
                                    aria-invalid="true"
                                {% elsif form.posted_successfully? %}
                                    aria-describedby="ContactFooter-success"
                                {% endif %}
                                placeholder="Enter your password"
                                required
                        >
                      
                        <div class="Form__ItemHelp Link Link--primary">
                            <a href="/account/login#recover">
                             Forgot password?
                            </a>
                        </div>
                    </div>



                    <button class="btn btn-warning">
                     Sign In
                    </button>

                </form>


                {% comment %}
                  Apply for an account
                {% endcomment %}

                <div class="b2b-apply-account" id="b2b-apply">

                    <h3 class="Heading u-h3">{{ section.settings.open_account_title }}</h3>

                    {{ section.settings.open_account_text }}

                    <a href="#b2b-apply" onclick="b2bRegister()" class="btn btn-warning">
                        {{ section.settings.open_account_button }}
                    </a>

                    {% comment %}
                      Application form

                      Use a custom form or use a standard Shopify contact form
                    {% endcomment %}

                    {% if section.settings.use_custom_form %}
                        <div id="b2b-register" class="b2b-registration-form" style="height: 0;">
                            <div class="b2b-application-form-wrapper">
                                {{ section.settings.open_account_form }}
                            </div>
                        </div>
                    {% else %}

                        {%- form 'contact', id: 'ContactForm' -%}
                            {%- if form.posted_successfully? -%}
                                <div class="form-status form-status-list form__message" tabindex="-1" autofocus>
                                  Thank you for your messsage, we will be in touch shortly!
                                </div>
                            {%- elsif form.errors -%}
                                <div class="form__message">
                                    <div class="Form__Alert Alert Alert--error">
                                        Sorry, there appears to be an error in your form submission.
                                    </div>
                                </div>

                            {%- endif -%}

                            <div id="b2b-register" class="b2b-registration-form" style="height: 0;">

                                <div class="contact__fields">

                                    <input class="field__input" autocomplete="name" type="hidden" id="ContactForm-Trade" name="contact[Trade Application]"  value="New trade customer application to review">
                                    <div class="Form__Item">
                                  
                                    <input class="Form__Input input" autocomplete="name" type="text" id="ContactForm-company" name="contact[Company]" placeholder="Legal Company Name">
                                   
                                    </div>
                                    <div class="Form__Item">
                                     
                                        <input class="Form__Input input" autocomplete="name" type="text" id="ContactForm-name" name="contact[Name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="Full Name">
                                        
                                    </div>
                                    <div class="Form__Item">
                                  
                                    <input class="Form__Input input" autocomplete="name" type="text" id="ContactForm-position" name="contact[Position]" placeholder="Position">
                                   
                                    </div>                               
                                    <div class="Form__Item">
                                   
                                        <input
                                                autocomplete="email"
                                                type="email"
                                                id="ContactForm-email"
                                                class="Form__Input input"
                                                name="contact[email]"
                                                spellcheck="false"
                                                autocapitalize="off"
                                                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                                                aria-required="true"
                                                {% if form.errors contains 'email' %}
                                                    aria-invalid="true"
                                                    aria-describedby="ContactForm-email-error"
                                                {% endif %}
                                                placeholder="Email"
                                        >
                                        
                                        {%- if form.errors contains 'email' -%}
                                            <small class="contact__field-error" id="ContactForm-email-error">
                                                <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                                                <span class="form__message">{% render 'icon-error' %}{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</span>
                                            </small>
                                        {%- endif -%}
                                    </div>
                                </div>
                                <div class="Form__Item">
                                  
                                    <input type="tel" id="ContactForm-phone" class="Form__Input input" name="contact[Phone]" pattern="[0-9\-]*" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" placeholder="Phone">
                                   
                                </div>

                                <div class="Form__Item">
                                 
                                    <input class="Form__Input input" autocomplete="name" type="text" id="ContactForm-website" name="contact[Website]" placeholder="Website">
                                    
                                </div>

                                <div class="Form__Item Form__Item--with-label">
                                    <label class="label-title">
                                        Are you conducting business within the US? 
                                    </label>
                                    <label for="businessWithinUSYes" class="radio-label">
                                        <input
                                          type="radio"
                                          id="businessWithinUSYes"
                                          name="contact[Business within US]"
                                          value="Yes"
                                          class="radio-button"
                                          checked="checked"
                                        >
                                        Yes
                                      </label>
                                      <label for="businessWithinUSNo" class="radio-label">
                                        <input
                                          type="radio"
                                          id="businessWithinUSNo"
                                          name="contact[Business within US]"
                                          value="No"
                                          class="radio-button"
                                        >
                                        No
                                      </label>
                                    {% comment %} <textarea
                                            rows="10"
                                            id="ContactForm-body"
                                            class="text-area Form__Input input"
                                            name="contact[Comments]"
                                            placeholder="Comments"
                                    >
                                        {{- form.body -}}
                                    </textarea> {% endcomment %}
                                   
                                </div>

                                <div class="Form__Item Form__Item--with-label">
                                    <label class="label-title">
                                        If Yes, where do you intend to sell?
                                    </label>
                                    <label for="SalesPlatformAmazon" class="checkbox-label">
                                        <input
                                          type="checkbox"
                                          id="SalesPlatformAmazon"
                                          name="contact[Sales Platform]"
                                          value=""
                                          class="checkbox-input"
                                        >
                                        Amazon
                                    </label>
                                    <label for="SalesPlatformWalmart" class="checkbox-label">
                                        <input
                                          type="checkbox"
                                          id="SalesPlatformWalmart"
                                          name="contact[Sales Platform]"
                                          value=""
                                          class="checkbox-input"
                                        >
                                        Walmart
                                    </label>   
                                    <label for="SalesPlatformEBay" class="checkbox-label">
                                        <input
                                          type="checkbox"
                                          id="SalesPlatformEBay"
                                          name="contact[Sales Platform]"
                                          value=""
                                          class="checkbox-input"
                                        >
                                        E-Bay
                                    </label>                                                                        
                                    <label for="SalesPlatformNewEgg" class="checkbox-label">
                                        <input
                                          type="checkbox"
                                          id="SalesPlatformNewEgg"
                                          name="contact[Sales Platform]"
                                          value=""
                                          class="checkbox-input"
                                        >
                                        NewEgg
                                    </label>   
                                    <label for="SalesPlatformOwnWebsite" class="checkbox-label">
                                        <input
                                          type="checkbox"
                                          id="SalesPlatformOwnWebsite"
                                          name="contact[Sales Platform]"
                                          value=""
                                          class="checkbox-input"
                                        >
                                        OwnWebsite
                                    </label>   
                                    <label for="SalesPlatformOthers" class="checkbox-label">
                                        <input
                                          type="checkbox"
                                          id="SalesPlatformOthers"
                                          name="contact[Sales Platform]"
                                          value=""
                                          class="checkbox-input"
                                        >
                                        Others
                                    </label>                                                                          
                                </div>
                                <div class="Form__Item Form__Item--with-label">
                                    <label class="label-title">
                                        Are you a government contractor?
                                    </label>
                                    <label for="governmentContractorYes" class="radio-label">
                                        <input
                                          type="radio"
                                          id="governmentContractorYes"
                                          name="contact[Government Contractor]"
                                          value="Yes"
                                          class="radio-button"
                                          checked="checked"
                                        >
                                        Yes
                                      </label>
                                      <label for="governmentContractorNo" class="radio-label">
                                        <input
                                          type="radio"
                                          id="governmentContractorNo"
                                          name="contact[Government Contractor]"
                                          value="No"
                                          class="radio-button"
                                        >
                                        No
                                    </label>
                                   
                                </div> 

                                <div class="Form__Item Form__Item--with-label">
                                    <label class="label-title">
                                        What products are you interested in? (Check all that apply)
                                    </label>
                                    <label for="interestedProduct360ExtensionCords" class="checkbox-label">
                                        <input
                                          type="checkbox"
                                          id="interestedProduct360ExtensionCords"
                                          name="contact[Interested Product]"
                                          value=""
                                          class="checkbox-input"
                                        >
                                        360 Extension Cords
                                    </label>
                                    <label for="interestedProductRegularExtensionCords" class="checkbox-label">
                                        <input
                                          type="checkbox"
                                          id="interestedProductRegularExtensionCords"
                                          name="contact[Interested Product]"
                                          value=""
                                          class="checkbox-input"
                                        >
                                        Regular Extension Cords
                                    </label>   
                                    <label for="interestedProductEthernetCables" class="checkbox-label">
                                        <input
                                          type="checkbox"
                                          id="interestedProductEthernetCables"
                                          name="contact[Interested Product]"
                                          value=""
                                          class="checkbox-input"
                                        >
                                        Ethernet Cables
                                    </label>                                                                        
                                    <label for="interestedProductHDMICables" class="checkbox-label">
                                        <input
                                          type="checkbox"
                                          id="interestedProductHDMICables"
                                          name="contact[Interested Product]"
                                          value=""
                                          class="checkbox-input"
                                        >
                                        HDMI Cables
                                    </label>   
                                    <label for="interestedProductCoaxialCables" class="checkbox-label">
                                        <input
                                          type="checkbox"
                                          id="interestedProductCoaxialCables"
                                          name="contact[Interested Product]"
                                          value=""
                                          class="checkbox-input"
                                        >
                                        Coaxial Cables
                                    </label>   
                                    <label for="interestedProductPlugAdapters" class="checkbox-label">
                                        <input
                                          type="checkbox"
                                          id="interestedProductPlugAdapters"
                                          name="contact[Interested Product]"
                                          value=""
                                          class="checkbox-input"
                                        >
                                        Plug Adapters
                                    </label>                                                                          
                                </div>                                                                                               
                                <div class="contact__button">
                                    <button type="submit" class="btn btn-warning">
                                      Apply now
                                    </button>
                                </div>

                            </div>
                        {%- endform -%}
                    {% endif %}

                </div>

                {% if section.settings.show_faqs %}
                    {% comment %}
                    FAQs
                    {% endcomment %}

                    <div class="b2b-faqs" id="faqs">

                        <h3 class="Heading u-h3">{{ section.settings.faq_title }}</h3>

                        {% for block in section.blocks limit:50 %}

                            <div class="faq-tab">
                                <a class="item-accordion">
                                    {{ block.settings.block_title }}
                                    <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-caret" viewBox="0 0 10 6">
                                        <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor">
                                    </svg>
                                </a>
                                <div class="panel">
                                    {{ block.settings.block_text }}
                                </div>
                            </div>

                        {% endfor %}

                    </div>

                {% endif %}

            </div>

        </div>

    </div>


    <script>
        var acc = document.getElementsByClassName("faq-tab");
        var i;

        for (i = 0; i < acc.length; i++) {
            acc[i].addEventListener("click", function() {
                this.classList.toggle("active");

            });
        }
        function b2bRegister() {
            var x = document.getElementById("b2b-register");
            if (x.style.height === "0") {
                x.style.height = "0";
            } else {
                x.style.height = "auto";
            }
        }

        if (window.location.hash === '#b2b-apply') {
            b2bRegister();
        }
    </script>

    {% schema %}
    {
    "name": "Login Page",
    "settings" : [
    {
    "type": "image_picker",
    "id": "featured_image",
    "label": "Background Image",
    "info": "The image should ideally be rectangular"
    },
    {
    "type": "color",
    "id": "background_color",
    "label": "Background color",
    "default": "#f1f1f1"
    },
    {
    "type": "text",
    "id": "title",
    "label": "Title",
    "default": "Welcome to our trade login"
    },
    {
    "type": "textarea",
    "id": "intro_text",
    "label": "Intoduction Text",
    "default": "Sign in below to get instant access to your trade account and to start placing orders."
    },
    {
    "type": "text",
    "id": "open_account_title",
    "label": "Open Account Title",
    "default": "Interest in opening an account?"
    },
    {
    "type": "richtext",
    "id": "open_account_text",
    "label": "Open Account Text",
    "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam.</p>"
    },
    {
    "type": "text",
    "id": "open_account_button",
    "label": "Open Account Button Title",
    "default": "Apply for an account"
    },
    {
    "type": "checkbox",
    "id": "use_custom_form",
    "label": "Use custom contact form",
    "info": "If enabled, you can paste in your HTML below. If disabled, the standard Shopify contact form will be used and the fields can be customised within the trade-application.liquid template",
    "default": false
    },
    {
    "type": "html",
    "id": "open_account_form",
    "label": "Custom Account Application Form",
    "default": "Paste in form HTML here"
    },
    {
    "type": "checkbox",
    "id": "show_faqs",
    "label": "Show FAQs",
    "info": "If enabled, you can manually add FAQs",
    "default": true
    },
    {
    "type": "text",
    "id": "faq_title",
    "label": "FAQs title",
    "default": "Question & Answers"
    }
    ],
    "blocks": [
    {
    "type": "feature",
    "name": "FAQs",
    "settings": [
    {
    "type": "text",
    "id": "block_title",
    "label": "Question"
    },
    {
    "type": "richtext",
    "id": "block_text",
    "label": "Answer"
    }

    ]
    }
    ],
    "presets": [
    {
    "name": {
    "en": "Login Page"
    },
    "category": {
    "en": "Wholesale & B2B"
    }
    }
    ]

    }
    {% endschema %}


    <style>


    .page-width.trade-login {
          max-width: 100%;
          margin: auto;
        }
      
        /*================ B2B Login page ================*/

        .b2b-login-wrapper {
            display: flex;
            margin: 0 0;
        }

        /* Main image */

        .b2b-login-wrapper .b2b-intro-image {
            width: 50%;
            padding: 8%;
            background-repeat: no-repeat;
            background-position: top center;
            background-size: cover;
            min-height: 300px;
        }

        /* Login area */

        .b2b-login-wrapper .b2b-login-area {
            width: 50%;
            padding: 7%;
        }

        .b2b-login-wrapper .b2b-login-area h1 {
            margin-top: 0;
        }

        .b2b-login-wrapper .b2b-login-area .intro-text p {
            margin: 0 0 20px;
        }

        .b2b-login-wrapper .b2b-login-area .form-vertical {
            position: relative;
        }

        .b2b-login-wrapper .b2b-login-area .form-vertical .intro-text {
            padding: 0 0 1.5em;
        }
  
        .b2b-login-wrapper .b2b-login-area .form-vertical input,
        .b2b-login-wrapper .b2b-login-area .form-vertical textarea {
            width: 100%;
            background: #fff;
            flex-grow: 1;
            text-align: left;
            padding: 1.5rem;
            margin: var(--inputs-border-width);
            transition: box-shadow var(--duration-short) ease;
        }
        .b2b-login-wrapper .b2b-login-area .Form__Item label.label-title {
            display: inline-block;
            padding-bottom: 10px;
        }        
        .b2b-login-wrapper .b2b-login-area .Form__Item label.radio-label, .b2b-login-wrapper .b2b-login-area .Form__Item label.checkbox-label {
            display: flex;
            margin-bottom: 4px;
        }
        .b2b-login-wrapper .b2b-login-area .Form__Item label.radio-label input, .b2b-login-wrapper .b2b-login-area .Form__Item label.checkbox-label input {
            width: auto;
            flex: 0;
            margin: 0 10px 0 0;
        }
        .b2b-login-wrapper .b2b-login-area .Form__Item.Form__Item--with-label {
            margin: 30px 0;
        }        
        .b2b-login-wrapper .b2b-login-area .form-vertical input::placeholder,
        .b2b-login-wrapper .b2b-login-area .form-vertical textarea::placeholder {
            color: #273cff;
        }
        .b2b-login-wrapper .b2b-login-area .Form__Item {
            margin: 0 0 15px;
        }

        .b2b-login-wrapper .b2b-login-area .form-vertical .password-container {
            position: relative;
        }

        .b2b-login-wrapper .b2b-login-area .form-vertical .password-container a {
            position: absolute;
            right: 0;
            top: 13px;
            font-size: 14px;
            line-height: 14px;
            color: #999;
            text-decoration: underline;
        }


        /* Apply for an account */

        .b2b-apply-account {
            padding: 3em 0 0;
            scroll-behavior: smooth;
        }

        .b2b-apply-account h3 {
            margin: 0 0 20px
        }

        .b2b-apply-account ul li {
            list-style: square;
        }

        .b2b-apply-account .form-status-list {
            margin: 2rem 0 0;
            background: #fff;
            padding: 1em;
        }

        .b2b-apply-account .form__message {
            display: block;
        }

        /* Registration form */

        .b2b-registration-form {
            transition: all 0.3s;
            overflow: hidden;
            padding: 0 1px;
            margin: 0 -1px;
        }

        .b2b-registration-form form {
            margin: 1em 0;
        }

        .b2b-registration-form .contact__fields {
            margin: 1em 0 0;
        }

        .b2b-application-form-wrapper {
            margin: 1em 0;
        }


        /* FAQs */

        .b2b-faqs {
            margin: 3em 0 0;
            border-top: 1px solid #ccc;
            padding: 3em 0 0;
        }

        .b2b-faqs h3 {
            margin: 0 0 1.5em;
        }

        .faq-tab a.item-accordion {
            display: block;
            background: #fff;
            padding: 1rem 3rem 1rem 1.5rem;
            margin-bottom: 1em;
            position: relative;
            color: #333;
            text-decoration: none;
            cursor: pointer;
            position: relative;
        }

        .faq-tab a.item-accordion svg {
            width: 18px;
            position: absolute;
            right: 15px;
            top: 25px;
            transition: all 0.2s;
        }

        .faq-tab.active a.item-accordion svg {
            transform: rotate(180deg);
        }

        .faq-tab .panel {
            max-height: 0;
            overflow: hidden;
            transition: all 0.3s ease-in;
        }

        .faq-tab.active .panel {
            max-height: 2500px;
        }

        .faq-tab .panel p {
            padding: 1em 1em 1em;
            margin: 0;
        }

        .faq-tab .panel p:last-of-type {
            padding-bottom: 2em;
        }

        .faq-tab .panel p a {
            text-decoration: underline;
            color: #334fb4;
        }

        .faq-tab .panel ul {
            margin: 0 0 0 2em;
        }

        .faq-tab .panel ul li {
            list-style-type: square;
        }

        .faq-tab .panel ul li a {
            text-decoration: underline;
        }

        .cf-button {
            background-color: #f1de2c;
            color: #273cff;
            &:hover {
                background-color: #273cff;
                color: #fff;
            }
        }
        /* Responsive */

        @media only screen and (max-width: 850px) {

            .b2b-login-wrapper {
                display: block;
                margin: 1em 0;
            }
            .b2b-login-wrapper .b2b-intro-image,
            .b2b-login-wrapper .b2b-login-area  {
                width: 100%;
            }

            .b2b-login-wrapper .b2b-intro-image {
                background-size: cover;
            }

            .faq-tab svg path {
                stroke: transparent
            }

        }


    </style>