{%- style -%}
  #shopByProduct {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
    #shopByProduct .sbp-item {
    flex: 0 0 calc((100% / {{ section.settings.slides_desktop }}) - (20px * ({{ section.settings.slides_desktop }} - 1) / {{ section.settings.slides_desktop }}));
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: #F9F9F9;
    padding: 10px;
    border-radius: 10px;
    border: 1px solid #F4F4F4;
  }
  @media (max-width: 991px) {
  #shopByProduct .sbp-item {
    flex: 0 0 calc(
      (100% / {{ section.settings.slides_tablet }}) -
      (12px * ({{ section.settings.slides_tablet }} - 1) / {{ section.settings.slides_tablet }})
    );
  }
}
@media screen and (max-width: 749px) {
    #shopByProduct {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    #shopByProduct .sbp-item {
      flex: 0 0 calc((100% / {{ section.settings.slides_mobile }}) - (12px * ({{ section.settings.slides_mobile }} - 1) / {{ section.settings.slides_mobile }}));
    }
}
{%- endstyle -%}

<div id="shopByProduct">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="sbp-heading">
        <h2 class="section-heading">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="sbp-slider-outer">

      <div class="sbp-nav sbp-prev" aria-label="Previous">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M15 6L9 12L15 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>

      <div class="sbp-wrapper" id="sbpWrapper">
        {%- for block in section.blocks -%}
          {%- assign collection = block.settings.collection -%}
          <div class="sbp-item" {{ block.shopify_attributes }}>

            {%- if collection != blank -%}
              <a href="{{ collection.url }}">
                {%- if block.settings.custom_image != blank -%}
                  <img src="{{ block.settings.custom_image | image_url: width: 600 }}" alt="{{ collection.title }}" loading="lazy">
                {%- elsif collection.image -%}
                  <img src="{{ collection.image | image_url: width: 600 }}" alt="{{ collection.title }}" loading="lazy">
                {%- endif -%}
              </a>
              <h3 class="sbp-title">
                {%- if block.settings.custom_title != blank -%}
                  {{ block.settings.custom_title }}
                {%- else -%}
                  {{ collection.title }}
                {%- endif -%}
            </h3>
            
              <a href="{{ collection.url }}" class="sbp-shopnow">
                {{ block.settings.button_label | default: 'Shop Now' }}
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M5 12H19M19 12L13 6M19 12L13 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            {%- else -%}
              <p>Select a collection</p>
            {%- endif -%}

          </div>
        {%- endfor -%}
      </div>

      <div class="sbp-nav sbp-next" aria-label="Next">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>

    </div>

  </div>
</div>

<script>
  (function () {
    var wrapper = document.getElementById('sbpWrapper');
    var root = wrapper.closest('.sbp-slider-outer');
    var prevBtn = root.querySelector('.sbp-prev');
    var nextBtn = root.querySelector('.sbp-next');

    function scrollAmount() {
      var item = wrapper.querySelector('.sbp-item');
      if (!item) return 300;
      var gap = parseInt(getComputedStyle(wrapper).gap) || 0;
      return item.getBoundingClientRect().width + gap;
    }

    prevBtn.addEventListener('click', function () {
      wrapper.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
    });

    nextBtn.addEventListener('click', function () {
      wrapper.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
    });
  })();
</script>

{% schema %}
{
  "name": "Shop by Product",
  "tag": "section",
  "class": "section-shop-by-product",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Product"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "range",
      "id": "slides_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Slides to show (Desktop)",
      "default": 6
    },
    {
      "type": "range",
      "id": "slides_tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Slides to show (Tablet)",
      "default": 3
    },
    {
      "type": "range",
      "id": "slides_mobile",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Slides to show (Mobile)",
      "default": 2
    },
    {
      "type": "header",
      "content": "Desktop Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    },
    {
      "type": "header",
      "content": "Mobile Padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "collection_block",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Choose collection"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom image (optional, overrides collection image)"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom title (optional, overrides collection name)"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop Now"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Product",
      "blocks": [
        { "type": "collection_block" },
        { "type": "collection_block" },
        { "type": "collection_block" },
        { "type": "collection_block" },
        { "type": "collection_block" },
        { "type": "collection_block" }
      ]
    }
  ]
}
{% endschema %}