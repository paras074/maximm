{{ 'section-plugged-into-future.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding-mobile {
      padding-top: {{ section.settings.padding_top_mobile | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom_mobile | divided_by: 10 }}rem;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 10 }}rem;
    }
  }
{%- endstyle -%}
<div
  class="plugged-into-future section-{{ section.id }}-padding  section-{{ section.id }}-padding-mobile"
  id="plugged-into-future">
  <div class="page-width">
    <div class="inner-page-width">
      <div class="image-holder">
        {{ section.settings.main_image | image_url: width: 1000 | image_tag }}
      </div>
      <div class="content-holder ">
        <div class="subtitle-filled">{{ section.settings.subtxt }}</div>
        {{ section.settings.content }}
        <a class="btn btn-primary" href="{{ section.settings.btn_url }}">
          {{ section.settings.btn_txt }}
          <span class="ico-holder">
            <img src="{{ 'maximm-logo-single-element-gradient.svg' | asset_url }}">
          </span>
        </a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Section: PI Future",
  "settings": [
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image"
    },
    {
      "type": "text",
      "id": "subtxt",
      "label": "Sub Text"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "btn_txt",
      "label": "Button: Text"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button: URL"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding Bottom",
      "default": 0
    }
  ]
}
{% endschema %}
