{{ 'section-industry-hotels.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding-mobile {
      padding-top: {{ section.settings.padding_top_mobile | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom_mobile | divided_by: 10 }}rem;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 10 }}rem;
    }
  }
{%- endstyle -%}
<div
  class="industry-hotels section-{{ section.id }}-padding section-{{ section.id }}-padding-mobile"
  id="industry-hotels">
  <div class="bgImg" style="background-image:url({{ 'grid-bg.svg' | asset_url }})"></div>
  <div class="page-width js-has-stretch">
    <div class="item-hotel item-hotel--1">
      <div class="st-row st-align-items-center">
        <div class="st-col-md-6 column-left">
          <div class="image-holder">
            {{ section.settings.main_image_top_section | image_url: width: 1000 | image_tag: class: 'w-100 hotel-1' }}
            <img class="logo-element parallaxBlockUp" src="{{ 'maximm-logo-element-yellow-gradient.svg' | asset_url }}">
          </div>
        </div>
        <div class="st-col-md column-right gutters-end-0">
          <div class="content-holder">
            {{ section.settings.content_top_section }}
          </div>
        </div>
      </div>
    </div>
    <div class="item-hotel item-hotel--2">
      <div class="st-row st-align-items-end">
        <div class="st-col-md column-right">
          <div class="js-stretch-right">
            <div class="image-holder">
              {{ section.settings.main_image_btm_section | image_url: width: 1000 | image_tag: class: 'w-100' }}
            </div>
          </div>
        </div>
        <div class="st-col-md-6 column-left d-md-flex flex-column align-items-end">
          <div class="content-holder">
            {{ section.settings.content_btm_section }}
            <a class="btn btn-primary" href="{{ section.settings.btn_url_btm_section }}">
              {{ section.settings.btn_txt_btm_section }}
              <span class="ico-holder">
                <img src="{{ 'maximm-logo-single-element-gradient.svg' | asset_url }}">
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Sec: Industry Hotels",
  "settings": [
    {
      "type": "image_picker",
      "id": "main_image_top_section",
      "label": "Top Section: Main Image"
    },
    {
      "type": "richtext",
      "id": "content_top_section",
      "label": "Top Section: Content"
    },
    {
      "type": "image_picker",
      "id": "main_image_btm_section",
      "label": "Bottom Section: Main Image"
    },
    {
      "type": "richtext",
      "id": "content_btm_section",
      "label": "Bottom Section: Content"
    },
    {
      "type": "text",
      "id": "btn_txt_btm_section",
      "label": "Bottom Section Button: Text"
    },
    {
      "type": "url",
      "id": "btn_url_btm_section",
      "label": "Bottom Section Button: URL"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding top",
      "default": 66
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding Bottom",
      "default": 90
    }
  ]
}
{% endschema %}
