{{ 'section-secondary-banner.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .section-{{ section.id }}-padding-mobile {
      padding-top: {{ section.settings.padding_top_mobile | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom_mobile | divided_by: 10 }}rem;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 10 }}rem;
    }
  }
{%- endstyle -%}
<div
  id="siteBanner"
  class="secondary-banner secondary-banner--brand section-{{ section.id }}-padding  section-{{ section.id }}-padding-mobile"
>
  <div
    class="bgImg d-none d-md-block js-parallax-banner-image"
    style="background-image:url({{ section.settings.main_bg_image_desktop | image_url: width: 2000 }})"
  ></div>
  <div
    class="bgImg d-md-none js-parallax-banner-image"
    style="background-image:url({{ section.settings.main_bg_image_mobile | image_url: width: 750 }})"
  ></div>
  <div class="page-width">
    <div class="inner-page-width gutters-end-0 ">
      {{ section.settings.content }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Banner: Secondary",
  "settings": [
    {
      "type": "image_picker",
      "id": "main_bg_image_desktop",
      "label": "Main Background Image Desktop"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "image_picker",
      "id": "main_bg_image_mobile",
      "label": "Main Background Image Mobile"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding Bottom",
      "default": 144
    }
  ]
}
{% endschema %}
