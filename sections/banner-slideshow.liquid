{{ 'banner-slideshow.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding-mobile {
      padding-top: {{ section.settings.padding_top_mobile | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom_mobile | divided_by: 10 }}rem;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 10 }}rem;
    }
  }
{%- endstyle -%}
{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}
<div class="hero-banner section-{{ section.id }}-padding  section-{{ section.id }}-padding-mobile">
  <div class="swiper js-banner-image-slider">
    <div class="swiper-wrapper">
      {% for slide in section.blocks %}
      <div class="swiper-slide">
        <div
          class="bgImg d-none d-md-block"
          style="background-image: url({{ slide.settings.image_desktop | image_url: width: 2200 }});"
        ></div>
        <div class="bgImg d-md-none"
          style="background-image: url({{ slide.settings.image_mobile | image_url: width: 700 }});"
        ></div>
      </div>
      {% endfor %}
    </div>
  </div>
  <div class="page-width">
    <div class="inner-page-width">
      <div class="swiper js-banner-content-slider">
        <div class="swiper-wrapper">
          {% for slide in section.blocks %}
            <div class="swiper-slide">
              <div class="content-holder h-100 d-flex flex-column">
                <div class="subtitle">{{ slide.settings.subtitle }}</div>
                <h1>
                  {{ slide.settings.title }}
                </h1>
                {%- if slide.settings.desc != blank%}
                  <div class="description">
                    {{ slide.settings.desc }}
                  </div>
                {%- endif -%}
                {%- if slide.settings.pdt_thumb_1 != blank or slide.settings.pdt_thumb_2 != blank  or slide.settings.pdt_thumb_3 != blank  or slide.settings.pdt_thumb_4 != blank -%}
                  <div class="product-thumb-wrapper">
                    {%- assign widths = '165, 360, 535' -%}
                    {%- capture sizes -%}
                      (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px,
                      (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)
                    {%- endcapture -%}                                
                    <ul>
                      {%- if slide.settings.pdt_thumb_1 != blank -%}
                        <li>
                          {{
                            slide.settings.pdt_thumb_1
                            | image_url: width: 535
                            | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
                          }}
                        </li>
                      {%- endif -%}
                      {%- if slide.settings.pdt_thumb_2 != blank -%}
                        <li>
                          {{
                            slide.settings.pdt_thumb_2
                            | image_url: width: 535
                            | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
                          }}
                        </li>
                      {%- endif -%}
                      {%- if slide.settings.pdt_thumb_3 != blank -%}
                        <li>
                          {{
                            slide.settings.pdt_thumb_3
                            | image_url: width: 535
                            | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
                          }}
                        </li>
                      {%- endif -%}
                      {%- if slide.settings.pdt_thumb_4 != blank -%}
                        <li>
                          {{
                            slide.settings.pdt_thumb_4
                            | image_url: width: 535
                            | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
                          }}
                        </li>
                      {%- endif -%}                                                      
                    </ul>
                  </div>
                {%- endif -%}  

                <div class="mt-auto">
                  <a class="btn btn-white" href="{{ slide.settings.btn_url }}"
                    >{{ slide.settings.btn_text }}
                    <span class="ico-holder">
                      <img src="{{ 'maximm-logo-single-element-gradient.svg' | asset_url }}" alt="banner-gradient">
                    </span>
                  </a>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
        <div>
          {% for block in section.blocks %}
            {% if forloop.length > 1 %}
              {% assign show_nav = "true" %}
            {% endif %}
          {% endfor  %}  
          {% if show_nav %}
            <div class="banner-pagination-with-fraction">
              <div class="swiper-pagination"></div>
              <div class="swiper-pagination-fraction-custom"></div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Banner: Slideshow",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Image (Desktop)"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Image (Mobile)"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "inline_richtext",
          "id": "desc",
          "label": "Description"
        },        
        {
          "type": "image_picker",
          "id": "pdt_thumb_1",
          "label": "Product Thumbnail 1"
        }, 
        {
          "type": "image_picker",
          "id": "pdt_thumb_2",
          "label": "Product Thumbnail 2"
        }, 
        {
          "type": "image_picker",
          "id": "pdt_thumb_3",
          "label": "Product Thumbnail 3"
        }, 
        {
          "type": "image_picker",
          "id": "pdt_thumb_4",
          "label": "Product Thumbnail 4"
        },                        
        {
          "type": "text",
          "id": "btn_text",
          "label": "Button Text"
        },
        {
          "type": "url",
          "id": "btn_url",
          "label": "Button URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banner: Slideshow"
    }
  ]
}
{% endschema %}
