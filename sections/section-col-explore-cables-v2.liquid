{{ 'section-explore-cable.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding-mobile {
      padding-top: {{ section.settings.padding_top_mobile | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom_mobile | divided_by: 10 }}rem;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 10 }}rem;
    }
  }
{%- endstyle -%}

<div class="explore-cables explore-cables--v2 section-{{ section.id }}-padding  section-{{ section.id }}-padding-mobile">
    <div class="page-width js-has-stretch">
      <div class="inner-page-width">
        <div class="section-heading">
          <div class="st-row">
            <div class="st-col-md-6 column-left">
              <h2>
                {{ section.settings.section_heading__title }}
              </h2>
            </div>
          </div>
        </div>
        <div class="js-stretch-right position-relative outer-swiper">
          <div class="floating-shape-1">
            <img src="{{ 'maximm-logo-single-element-gradient-header.svg' | asset_url }}">
          </div>
          <div class="swiper js-explore-cables-slider">
            <div class="swiper-wrapper">
              {% for image in collection.metafields.custom.gallery.value %}
              <div class="swiper-slide">
                <div class="product-image">
                  {{ image | image_url: width: 500 | image_tag }}
                </div>
              </div>
              {% endfor %}
            </div>
          </div>          
        </div>
        <div class="swiper-controller row align-items-center">
          <div class="col">
            <div class="swiper-pagination"></div>
          </div>
          <div class="col-auto swiper-buttons">
            <div class="swiper-button-prev"></div>
            <div class="swiper-button-next"></div>
          </div>
        </div>
      </div>
  </div>
</div>

{% schema %}
{
  "name": "Sec: Explore Cables V2",
  "settings": [
    {
      "type": "text",
      "id": "section_heading__title",
      "label": "Section Heading Title"
    },
    {
      "type": "richtext",
      "id": "section_heading__description",
      "label": "Section Heading Description"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding Bottom",
      "default": 50
    }
  ]
}
{% endschema %}
