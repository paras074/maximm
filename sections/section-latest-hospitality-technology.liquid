{{ 'section-latest-hospitality-technology.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding-mobile {
      padding-top: {{ section.settings.padding_top_mobile | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom_mobile | divided_by: 10 }}rem;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 10 }}rem;
    }
  }
{%- endstyle -%}
<div class="latest-hospitality-technology section-{{ section.id }}-padding  section-{{ section.id }}-padding-mobile">
  <div class="page-width js-has-stretch">
    <div class="st-row no-gutters">
      <div class="st-col-md-6 content-holder">
        <div>
          <div class="subtitle-filled">{{ section.settings.subtxt }}</div>
          <h2>
            {{ section.settings.title }}
          </h2>
        </div>
        <div class="content-holder__footer mt-auto">
          <div class="st-row st-align-items-center">
            <div class="st-col elems-left">
              <div class="label">
                <a href="{{ section.settings.btn_url }}">
                  <u>{{ section.settings.btn_txt }}</u>
                </a>
              </div>
            </div>
            <div class="st-col-auto elems-right">
              <img class="ico" src="{{ 'maximm-logo-single-element-white.svg' | asset_url }}">
            </div>
          </div>
        </div>
      </div>
      <div class="st-col-md-6 image-holder">
        <div class="js-stretch-right js-stretch-left h-100">
          {{ section.settings.main_image | image_url: width: 1000 | image_tag }}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Section: Hospitality Tech",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "subtxt",
      "label": "Sub Text"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image"
    },
    {
      "type": "text",
      "id": "btn_txt",
      "label": "Button: Text"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button: URL"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding Bottom",
      "default": 0
    }
  ]
}
{% endschema %}
