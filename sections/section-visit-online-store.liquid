{{ 'section-visit-online-store.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding-mobile {
      padding-top: {{ section.settings.padding_top_mobile | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom_mobile | divided_by: 10 }}rem;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | divided_by: 10 }}rem;
      padding-bottom: {{ section.settings.padding_bottom | divided_by: 10 }}rem;
    }
  }
{%- endstyle -%}
<div class="visit-online-store section-{{ section.id }}-padding  section-{{ section.id }}-padding-mobile">
  <div class="floatingBg">
    <img class="w-100 anim-zoom-in-zoom-out" src="{{ 'about-bg-2.svg' | asset_url }}">
  </div>
  <div class="page-width">
    <div class="inner-page-width">
      <div class="description gutters-end-0">
        {{ section.settings.description }}
      </div>
      <div class="footer-block">
        <div class="st-row st-justify-content-between st-align-items-center">
          <div class="st-col-auto">
            <img class="logo-amazon" src="{{ 'amazon-1.png' | asset_url }}">
          </div>
          <div class="st-col-auto">
            <a class="btn btn-primary" href="{{ section.settings.btn_url }}" target="_blank">
              {{ section.settings.btn_txt }}
              <span class="ico-holder">
                <img src="{{ 'maximm-logo-single-element-gradient.svg' | asset_url }}">
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Section: Testimonials",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "btn_txt",
      "label": "Button: Text"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button: URL"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 110
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 220,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 220
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding top",
      "default": 66
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile: Padding Bottom",
      "default": 50
    }
  ]
}
{% endschema %}
